---
// Contact.
//
// THIS PAGE IS THE BLOCKER THREE ERROR STATES ARE WAITING ON. CLAUDE.md requires
// a phone number on an error, and there has never been a real one — so the
// blocked message on /order, the failure messages in /api/checkout, and the
// M-Pesa messages in /api/mpesa/stk all end by routing someone here instead of
// printing a number. Every one of those is currently a route to a page that
// cannot finish the sentence.
//
// It is still not invented, and it is not apologised for either. A number that
// does not ring is worse than no number: it turns a buyer who was merely stuck
// into one who has been lied to, at the moment they are already worried about
// their money. And a paragraph explaining that there is no number yet is a stub
// with better manners — the rule for this step is that a fact which does not
// exist is not rendered.
//
// So the routes that DO exist are rendered, and the ones that do not are absent.
// What remains is true and useful: an order can be checked without an account,
// and the delivery terms are one link away.
//
// WHEN A REAL NUMBER LANDS, IT IS ONE COMMIT: site.json, then the three error
// states above, wired through together. Recorded in BUILD-ORDER section 10 so it
// is one edit rather than four rediscoveries.
import Base from "../layouts/Base.astro";
import Gap from "../components/Gap.astro";
import { site, known } from "../lib/site";

const { phone, whatsapp, hours } = site.contact;
const hasPhone = known(phone);
const hasWhatsapp = known(whatsapp);
const hasHours = known(hours);
const reachable = hasPhone || hasWhatsapp;

// Digits only, for the tel: and wa.me hrefs. Never rendered as the label.
const digits = (value: string | null) => (value ?? "").replace(/[^\d+]/g, "");
---

<Base
  title="Contact — MomentAura"
  description="How to reach a person about an order, and how to check one yourself."
  system="light"
>
  <section class="page">
    <div class="wrap page__inner">
      <h1 class="page__heading">Contact</h1>

      {
        reachable && (
          <p class="page__body">
            A person answers these. If it is about an order, have the reference ready — it
            is on your confirmation screen and looks like MA-4KLM-2XQP.
          </p>
        )
      }

      {
        hasPhone && (
          <p class="reach">
            <span class="reach__label">Phone</span>
            <a class="reach__value" href={`tel:${digits(phone)}`}>{phone}</a>
          </p>
        )
      }

      {
        hasWhatsapp && (
          <p class="reach">
            <span class="reach__label">WhatsApp</span>
            <a class="reach__value" href={`https://wa.me/${digits(whatsapp).replace(/^\+/, "")}`}>
              {whatsapp}
            </a>
          </p>
        )
      }

      {
        hasHours && (
          <p class="reach">
            <span class="reach__label">Hours</span>
            <span class="reach__value">{hours}</span>
          </p>
        )
      }

      <Gap field="contact.phone" />
      <Gap field="contact.whatsapp" />
      <Gap field="contact.hours" />

      <h2 class="page__sub">Checking an order yourself</h2>
      <p class="page__body">
        An order can be looked up with its reference and the phone number it was placed
        with, without an account and without a password, on the <a href="/track"
          >track an order</a
        > page.
      </p>

      <h2 class="page__sub">Delivery and returns</h2>
      <p class="page__body">
        How payment works, where orders are sent from, and the returns terms are on the <a
          href="/delivery">delivery</a
        > page.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .page__inner {
    max-width: var(--max-width);
  }

  .page__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  .page__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-16);
    margin-block-start: var(--s-40);
  }

  .page__body {
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-block-end: var(--s-20);
  }

  /* A way to reach a person is a checkable fact, so it sits in the data
     register. The accent stays off it: --accent means "you can verify this" and
     is confined to two sanctioned sites, and a phone number is an instruction to
     act rather than a lead time to check. */
  .reach {
    display: grid;
    gap: var(--s-8);
    margin-block-end: var(--s-20);
  }

  .reach__label {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
  }

  .reach__value {
    font-family: var(--font-mono);
    font-size: var(--t-body-sm);
    letter-spacing: var(--tr-docket);
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }
</style>
