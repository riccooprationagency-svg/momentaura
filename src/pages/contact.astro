---
// Contact.
//
// Every way of reaching a person, each with one line saying what it is for, and
// then the two things a buyer can do without reaching anyone: look an order up,
// and read the delivery terms.
//
// WhatsApp leads, as the one filled button in the section, because it is the
// route most buyers in Nairobi already have open. The number is the same for
// calls, and it is said once rather than twice.
//
// NO HOURS, AND NO RESPONSE TIME. Neither is known, and "replies within the
// hour" is exactly the kind of sentence a buyer who has been ignored before
// will test. contact.hours stays null in site.json and renders nothing until it
// is real; the dev-only marker below says so.
//
// Every href comes from lib/site.ts. Nothing here spells a number or an address.
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Gap from "../components/Gap.astro";
import {
  emailParts,
  known,
  mailtoHref,
  phoneDisplay,
  site,
  telHref,
  whatsappHref,
} from "../lib/site";

const { hours } = site.contact;
const hasHours = known(hours);
---

<Base
  title="Contact — MomentAura"
  description="WhatsApp and phone 0753 181 901, and email for general questions and order problems."
  system="light"
>
  <section class="page">
    <div class="wrap page__inner">
      <h1 class="page__heading">Contact</h1>

      <p class="page__body">
        A person answers these. If it is about an order, have the reference ready — it is
        on your confirmation screen and looks like MA-4KLM-2XQP.
      </p>

      <div class="reach reach--lead">
        <p class="reach__label">WhatsApp</p>
        <Button variant="filled" href={whatsappHref("WEB-CONTACT")}>
          Message MomentAura on WhatsApp
        </Button>
        <p class="reach__for">
          For anything — a product, an order, or delivery. The number is {phoneDisplay()}.
        </p>
      </div>

      <div class="reach">
        <p class="reach__label">Phone</p>
        <a class="reach__value" href={telHref()}>Call {phoneDisplay()}</a>
        <p class="reach__for">The same number as WhatsApp, for a call instead of a message.</p>
      </div>

      <div class="reach">
        <p class="reach__label">General questions</p>
        <a class="reach__value" href={mailtoHref("general")}
          >{emailParts("general")[0]}<wbr />{emailParts("general")[1]}</a
        >
        <p class="reach__for">Questions about a product, or anything not tied to an order.</p>
      </div>

      <div class="reach">
        <p class="reach__label">Order problems</p>
        <a class="reach__value" href={mailtoHref("orders")}
          >{emailParts("orders")[0]}<wbr />{emailParts("orders")[1]}</a
        >
        <p class="reach__for">
          Something wrong with an order already placed. Put the order reference in the
          subject.
        </p>
      </div>

      {
        hasHours && (
          <div class="reach">
            <p class="reach__label">Hours</p>
            <p class="reach__value">{hours}</p>
          </div>
        )
      }

      <Gap field="contact.hours" />

      <h2 class="page__sub">Checking an order yourself</h2>
      <p class="page__body">
        An order can be looked up with its reference and the phone number it was placed
        with, without an account and without a password, on the <a href="/track"
          >track an order</a
        > page.
      </p>

      <h2 class="page__sub">Delivery and payment</h2>
      <p class="page__body">
        How payment works, where orders are sent from, and what delivery costs are on the <a
          href="/delivery">delivery</a
        > page.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .page__inner {
    max-width: var(--max-width);
  }

  .page__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  .page__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-16);
    margin-block-start: var(--s-40);
  }

  .page__body {
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-block-end: var(--s-20);
  }

  /* A way to reach a person is a checkable fact, so the number and the
     addresses sit in the data register. The accent stays off all of it:
     --accent means "you can verify this" and is confined to two sanctioned
     sites, and a phone number is an instruction to act rather than a lead time
     to check. */
  .reach {
    display: grid;
    gap: var(--s-8);
    justify-items: start;
    padding-block: var(--s-20);
    border-block-start: 1px dashed var(--border);
  }

  .reach--lead {
    border-block-start: 0;
    padding-block-start: 0;
  }

  .reach__label {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
  }

  .reach__value {
    font-family: var(--font-mono);
    font-size: var(--t-body-sm);
    letter-spacing: var(--tr-docket);
    min-height: var(--tap-target);
    /* Block, not flex: a flex container makes the text one anonymous item and
       the <wbr> after "@" stops being a line-break opportunity. Padding gives
       the 44px target that flex centring gave before. */
    display: block;
    padding-block: var(--s-12);
  }

  .reach__for {
    color: var(--fg-muted);
    max-width: var(--measure);
  }
</style>
