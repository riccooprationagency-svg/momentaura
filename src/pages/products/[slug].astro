---
// One product, in three rows.
//
//   Row 1  the object left at 3:4 — with a thumbnail strip beside it when there
//          are two or more photographs — and everything a buyer needs to decide
//          on the right, both aligned top
//   Row 2  the size chart left, when there is one, and one more photograph
//          right when there are three or more. Otherwise the chart takes the
//          full width
//   Row 3  more in the same category, up to four, and a link to all of it
//
// Below 900px it is one column in that order, and the row 2 photograph is
// dropped: on a phone it would be the same photograph a third time, a long
// scroll below everything a buyer acts on.
//
// Not built, each because the data or the photography does not exist. Decisions,
// not gaps — see BUILD-ORDER sections 6 and 14:
//
//   Returns          no returns field exists in products.json, and no returns
//                    policy exists to describe. The section is not scaffolded:
//                    an empty heading over nothing would read as a policy
//   Box-opening      no image sequence, and it is the one elaborate moment on
//                    the site — it arrives with real frames or not at all
//   Size buttons     the size is chosen at checkout, on the order line it
//                    sizes. The cart stores slug and quantity only
//
// Quantity: the steppers live on /order. Adding twice from this page adds two,
// which is the same answer with one fewer control on the page where the buyer
// is still deciding.
//
// KNOWN, and blocked on data: the docket renders lead time as a duration, and
// CLAUDE.md requires a date on a product page. leadTimeDays is null on every
// product, so no lead time renders at all and there is nothing to convert yet.
// The date has to be computed from a real lead time against real working days;
// it cannot be derived from a null. It lands with the first true lead time.
import Base from "../../layouts/Base.astro";
import Docket from "../../components/Docket.astro";
import Button from "../../components/Button.astro";
import ProductCard from "../../components/ProductCard.astro";
import Gallery from "../../components/Gallery.astro";
import DeliveryFrom from "../../components/DeliveryFrom.astro";
import { whatsappHref } from "../../lib/site";
import {
  categories,
  products,
  relatedTo,
  sizeChart,
  systemFor,
  price,
  type Category,
  type Product,
} from "../../lib/products";

export function getStaticPaths() {
  const named = new Map(categories.map((c) => [c.slug, c]));

  return products.map((product) => ({
    params: { slug: product.slug },
    props: {
      product,
      category: named.get(product.category)!,
      related: relatedTo(product),
    },
  }));
}

interface Props {
  product: Product;
  category: Category;
  related: Product[];
}

const { product, category, related } = Astro.props as Props;

const system = systemFor(product);

// Zero is a fact, not a missing value. Every product is stock 0 today, so this
// page renders the closed state in practice; the open branch is the same
// condition read the other way, not a second design.
const soldOut = product.stock === 0;
const chart = sizeChart(product);

// Gallery draws the strip from two photographs up; the page only has to make
// room for it. The second-row photograph needs three: with two, the last one is
// a thumbnail away already, and the second row would repeat half the shoot.
const strip = product.photos.length >= 2;
const closeup = product.photos.length >= 3;

/* ---------- the information section ----------
 *
 * One: SIZE AND FIT, rendered when the size chart is — sizes[] non-empty and
 * every size measured. With sizes and no measurements it would be a heading over
 * a repeat of the sizes line above it. Fit is not repeated here: the docket
 * already states it. It opens by default; it is the only section.
 *
 * Cut, each because it repeated something already on the page, and CLAUDE.md
 * says a section that can be cut without losing information is cut:
 *
 *   Details    the description, which sits beside the price
 *   Materials  the docket's fabric-weight row
 *   Delivery   one line linking /delivery, which the nav, the footer and
 *              the "Delivery from" line beside the docket already reach
 */
const meta = [product.name, price(product.price)].join(", ");
const description = product.dispatch ? `${meta}. Dispatched from ${product.dispatch}.` : `${meta}.`;
---

<Base title={`${product.name} — MomentAura`} description={description}>
  <section class="detail" data-system={system}>
    <div
      class:list={[
        "wrap",
        "detail__inner",
        { "detail__inner--strip": strip, "detail__inner--closeup": closeup },
      ]}
    >
      <!-- detail — the one surface that opts in, the same way it is the one
           surface that passes `detail` to Docket below. The first photograph is
           eager at high fetch priority: it is above the fold and the largest
           element on the page, so it is the LCP candidate. -->
      <div class="detail__object">
        <Gallery product={product} detail />
      </div>

      <div class="detail__body">
        <p class="detail__category">
          <a href={`/${category.slug}`}>{category.name}</a>
        </p>

        <h1 class="detail__name">{product.name}</h1>

        <p class="detail__price">{price(product.price)}</p>

        <!-- Description omitted while null, the same rule the docket applies to
             its null fields. Describing how a garment feels before anyone has
             handled one would be inventing facts. -->
        {product.description && <p class="prose detail__prose">{product.description}</p>}

        <hr class="detail__hair" />

        <!--
          SIZES, from products.json and nowhere else. The size is chosen at
          checkout on the line it sizes, from a native <select> that posts with
          the form: the cart script is held to a byte budget, and a picker here
          would mean carrying a size through storage, the order page and back.
          Saying so here is what keeps the buyer from looking for it.
        -->
        {
          product.sizes.length > 0 && (
            <p class="detail__sizes">
              Sizes: {product.sizes.map((s) => s.label).join(", ")}. You choose one at checkout.
            </p>
          )
        }

        <!--
          The out-of-stock ruling. The button renders disabled, never absent.

          A missing button leaves the buyer wondering whether the page is broken
          or the product unbuyable, and that ambiguity is the suspicion this
          whole system exists to reduce.

          SOLD OUT IS A STATE, NOT A VERB. A sold-out product renders a disabled
          control that says "Sold out" in muted mono, carries no data-add so the
          cart never binds to or relabels it, and points at the line below that
          says why. No stamp beside it: the docket's Stock row carries the one
          Seal fill this page gets.

          data-stock is what the cart clamps the add handler against. It is a
          courtesy, not a control; functions/api/mpesa/stk.js re-reads stock from
          the catalogue and is what actually stops the order.
        -->
        {
          soldOut ? (
            <Button variant="filled" disabled describedby="detail-closed">
              <span class="detail__soldout">Sold out</span>
            </Button>
          ) : (
            <Button variant="filled" data-add data-slug={product.slug} data-stock={product.stock}>
              Add to order
            </Button>
          )
        }

        {
          soldOut && (
            <p class="detail__closed" id="detail-closed">
              {product.name} is in the catalogue. It cannot be ordered until there is stock
              to send.
            </p>
          )
        }

        <!-- Hidden until the order holds this product, and revealed by the cart.
             The button keeps its verb and says "Added to order"; this says how
             many and where they are. Prose, so Archivo, not mono. -->
        <p class="detail__added" data-added hidden>
          <span data-added-count>0</span> in your order. <a href="/order">See your order</a>.
        </p>

        <!-- detail — the one place the Seal fill is spent. Every other surface
             composing Docket leaves it off by default. -->
        <Docket product={product} detail />

        <!-- The route to a person, beside the decision rather than in the
             footer. The prefilled text names the product. -->
        <p class="detail__ask">
          Questions about this item? <a href={whatsappHref(product)}
            >Message MomentAura on WhatsApp</a
          >.
        </p>

        <DeliveryFrom />
      </div>

      <!--
        Native <details>, no script, open by default. A buyer who has seen the
        chart can fold it away; one who has not is not made to look for it.
      -->
      {
        chart && (
          <div class="detail__info">
            <details class="info" open>
              <summary class="info__summary">Size and fit</summary>
              <div class="info__body">
                <table class="detail__chart">
                  <caption class="detail__chart-caption">Size chart, in centimetres</caption>
                  <thead>
                    <tr>
                      <th scope="col">Size</th>
                      <th scope="col">Chest</th>
                      <th scope="col">Length</th>
                    </tr>
                  </thead>
                  <tbody>
                    {chart.map((size) => (
                      <tr>
                        <th scope="row">{size.label}</th>
                        <td>{size.chestCm}</td>
                        <td>{size.lengthCm}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </details>
          </div>
        )
      }

      {
        closeup && (
          <div class="detail__closeup">
            <Gallery product={product} last />
          </div>
        )
      }
    </div>
  </section>

  {
    /* Same category only, never padded from another. Two products sit alone in
       their category, so this section does not render on their pages at all —
       an empty heading over an empty grid is a worse answer than no heading. */
    related.length > 0 && (
      <section class="related">
        <div class="wrap">
          <div class="related__head">
            <h2 class="related__heading">More in {category.name}</h2>
            <a class="related__all" href={`/${category.slug}`}>All {category.name}</a>
          </div>
          <div class="related__grid">
            {related.map((item) => (
              <ProductCard product={item} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</Base>

<style>
  /* Paints --bg because it sets data-system. Without it the subtree's text and
     borders switch systems while the ground stays behind, which reads as broken
     and involves no illegitimate token. verify.mjs V7 asserts this. */
  .detail {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .detail__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-40);
    align-items: start;
  }

  .detail__body {
    display: grid;
    gap: var(--s-20);
    justify-items: start;
  }

  .detail__category {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* A standalone link, not a link inside prose, so it carries the same 44px hit
     area as the nav links, the order count and the footer links. */
  .detail__category a {
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .detail__category a:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* Sentence case, --t-heading. Product names say what the thing is, and an
     uppercased product name stops being a name and becomes a banner. */
  .detail__name {
    font-size: var(--t-heading);
    line-height: var(--lh-display);
    text-transform: none;
    font-weight: var(--w-medium);
  }

  .detail__price {
    font-family: var(--font-mono);
    font-size: var(--t-body-sm);
    letter-spacing: var(--tr-docket);
    /* Prices align digit for digit against the docket's figures below. */
    font-variant-numeric: tabular-nums;
  }

  .detail__prose {
    margin-block: var(--s-8);
  }

  /* The docket is full width of the column; everything else sits at its start. */
  .detail__body :global(.docket) {
    justify-self: stretch;
  }

  /* Short status beside an action: muted mono, uppercase, no fill. The muted
     colour and outline come from the button's own disabled state. */
  .detail__soldout {
    font-family: var(--font-mono);
    letter-spacing: var(--tr-docket);
  }

  .detail__closed,
  .detail__sizes,
  .detail__added,
  .detail__ask {
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  /* A standalone action, so a full thumb-sized target like the category link. */
  .detail__ask a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .detail__hair {
    border: 0;
    border-block-start: 1px solid var(--border);
    width: 100%;
    margin: 0;
  }

  /* ---------- the information section ---------- */

  /* A hairline above and below. No box, no fill, no icon. The disclosure
     marker is the browser's own, left as it is. */
  .detail__info {
    border-block-start: 1px solid var(--border);
  }

  .info {
    border-block-end: 1px solid var(--border);
  }

  .info__summary {
    min-height: var(--tap-target);
    padding-block: var(--s-12);
    cursor: pointer;
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  .info__body {
    display: grid;
    gap: var(--s-12);
    justify-items: start;
    padding-block-end: var(--s-20);
  }

  .detail__chart {
    justify-self: stretch;
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    font-variant-numeric: tabular-nums;
  }

  .detail__chart th,
  .detail__chart td {
    text-align: start;
    padding-block: var(--s-8);
    padding-inline-end: var(--s-20);
    border-block-end: 1px solid var(--border);
  }

  .detail__chart-caption {
    text-align: start;
    font-family: var(--font-sans);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
    color: var(--fg-muted);
    padding-block-end: var(--s-8);
  }

  /* A <th> is bold by default, which is over the 500 ceiling. */
  .detail__chart th {
    font-weight: var(--w-regular);
  }

  .detail__chart thead th {
    color: var(--fg-muted);
    text-transform: uppercase;
  }

  /* Dropped below 900px. A lazy image that is display: none is never fetched,
     so a phone does not pay for it. */
  .detail__closeup {
    display: none;
  }

  /* ---------- related ---------- */

  .related {
    padding-block-end: var(--s-80);
  }

  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-12) var(--s-20);
    margin-block-end: var(--s-40);
  }

  .related__heading {
    font-size: var(--t-heading);
  }

  /* A standalone route, so a full thumb-sized target, set as a label. */
  .related__all {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    font-size: var(--t-label);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }

  /* Up to four. One column, two from 640px, three from 900px and four from
     1100px, where four cards across the 1176px content box are 279px each —
     over --card-min. At 900px four would be 194px, under it. */
  .related__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-40) var(--s-20);
  }

  @media (min-width: 640px) {
    .related__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    /* The photograph takes the same 40% share as a homepage reveal, so the two
       pages read as one system rather than two layouts. With a strip, the
       column grows by the strip and its gap rather than the photograph
       shrinking to make room. */
    .detail__inner {
      grid-template-columns: var(--reveal-object) 1fr;
      gap: var(--s-80) var(--s-56);
    }

    .detail__inner--strip {
      grid-template-columns: calc(var(--reveal-object) + var(--thumb-width) + var(--s-12)) 1fr;
    }

    /* Row 2. The chart takes the full width unless there is a photograph to
       sit beside it. */
    .detail__info {
      grid-column: 1 / -1;
    }

    .detail__inner--closeup .detail__info {
      grid-column: 1;
    }

    .detail__closeup {
      display: block;
      grid-column: 2;
    }

    .related__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1100px) {
    .related__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
