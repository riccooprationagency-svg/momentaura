---
// Delivery.
//
// TITLED "DELIVERY", NOT "DELIVERY AND RETURNS", while no returns terms exist.
// A heading that promises returns on a page with none is the same broken promise
// as a dead link. When delivery.returnsWindowDays and returnsCondition are both
// set, the Returns section below renders and the title, the footer label in
// Base.astro and the cross-references on the product, order and checkout pages
// change back together.
//
// OMISSION, NOT A STATED ABSENCE. Where a fact does not exist the element is not
// rendered at all — no zone table, no returns heading, no sentence explaining
// that a zone table would go here. A page missing a section is honest. A page
// carrying "[areas]", "coming soon", or a paragraph apologising for the gap is a
// stub that shipped, and it tells a buyer the shop was assembled from a template
// and abandoned — which is precisely the suspicion this site exists to reduce.
//
// The absences are recorded in BUILD-ORDER section 10, with what each one needs,
// so they read as decisions rather than as things nobody noticed. The dev-only
// marker names the key in site.json; a production build never sees it.
//
// PAYMENT IS THE ONE SECTION THAT CAN BE WRITTEN IN FULL TODAY, because it
// describes what the code does rather than a fact only Ric holds.
import Base from "../layouts/Base.astro";
import Gap from "../components/Gap.astro";
import { GATEWAY_NAME } from "../../functions/api/_daraja.js";
import {
  site,
  known,
  feeText,
  phoneDisplay,
  telHref,
  whatsappHref,
  zonesByRegion,
  afterPaymentLines,
  dispatchRule,
  arrivalFor,
  feeRange,
} from "../lib/site";

const afterPaid = afterPaymentLines();
const rule = dispatchRule();

const hasZones = known(site.delivery.zones);
const regions = zonesByRegion();
const hasDispatch = known(site.delivery.dispatchFrom);
// Both halves or neither. A window with no condition, or a condition with no
// window, is half a promise.
const hasReturns = known(site.delivery.returnsWindowDays) && known(site.delivery.returnsCondition);
---

<Base
  title="Delivery — MomentAura"
  description={`How orders are paid for by ${GATEWAY_NAME}, where they are sent from, and what delivery costs.`}
  system="light"
>
  <section class="page">
    <div class="wrap page__inner">
      <h1 class="page__heading">Delivery</h1>

      <h2 class="page__sub">Paying</h2>
      <!-- Written from checkout.astro, cart.ts and functions/api/mpesa/stk.js:
           the form posts to /api/mpesa/stk, which re-prices the order and pushes
           an STK prompt to the phone number given, and the cart then moves to
           /order-received on this site, which polls /api/mpesa/status. There is
           no redirect to a payment page at any point. -->
      <p class="page__body">
        Payment is by {GATEWAY_NAME}. At checkout you give a name and the phone number the
        payment should go through. Pressing Pay sends a {GATEWAY_NAME} payment prompt to
        that phone, and you enter your PIN on the phone to pay. You do not leave this
        site: the next page shows your order reference and changes to paid once the
        payment is confirmed.
      </p>
      <p class="page__body">
        <strong>No card details are ever entered on this site.</strong> There is no card
        form anywhere in it.
      </p>
      <p class="page__body">
        Nothing is charged until you enter your PIN on the prompt, and nothing is
        dispatched until that payment is confirmed. Prices are in Kenyan shillings and the
        price on the product page is the price of the item.
      </p>

      {
        /* From site.json delivery.afterPayment, through the same helper the
           confirmation and /privacy use. Only the messages Ric said are sent;
           no timing, because none was stated. */
        afterPaid.length > 0 && (
          <>
            <hr class="page__hair" />
            <h2 class="page__sub">After you pay</h2>
            {afterPaid.map((line) => (
              <p class="page__body">{line}</p>
            ))}
          </>
        )
      }

      {
        hasDispatch && (
          <>
            <hr class="page__hair" />
            <h2 class="page__sub">{rule === null ? "Dispatch" : "Dispatch and arrival"}</h2>
            <p class="page__body">
              Every order is packed and sent from {site.delivery.dispatchFrom}.
            </p>
            {/* Ric's rule, stated once. A rule rather than a date: see lib/site.ts. */}
            {rule !== null && (
              <>
                <p class="page__body">
                  Working days are {rule.workingDays}. {rule.rule}
                </p>
                <p class="page__body">
                  The time to arrive is counted from dispatch and is shown under each region
                  below.
                </p>
              </>
            )}
          </>
        )
      }

      {
        /*
          The fee table, from site.json delivery.zones — the same rows the
          checkout select is built from and the server prices by, so the figure
          read here is the figure charged.

          ONE REGION, ONE BOX, except the first. The first region in site.json
          (Nairobi) is where most orders go, so each of its zones is its own
          box, always open: a buyer in the CBD should not have to open anything
          to read "Free". Every other region is one box on a native <details>,
          closed, its summary carrying the region's fee range, its county count
          and its arrival time — enough to decide whether to open it. Open, it
          is the county table as before. Native disclosure, so every fee is
          readable with JavaScript off, and a browser's find-in-page opens a
          closed region to a match.

          The fee range and the count are computed here from the same zones the
          table lists; nothing in this block is typed by hand.

          data-region names the region a box belongs to, and data-timing marks
          its arrival time. V18 reads both: a region with no box, or a box with
          no timing, fails the build.
        */
        hasZones && (
          <section id="fees" class="fees" aria-labelledby="fees-heading">
            <hr class="page__hair" />
            <h2 class="page__sub" id="fees-heading">Delivery fees</h2>
            <p class="page__body">
              One fee per order, not per item, set by the county the order is going to.
              Choose the county at checkout and the fee is added to the total before the
              M-Pesa prompt is sent.
            </p>
            <ul class="fees__grid" role="list">
              {regions.map(({ region, zones }, i) => {
                const arrives = arrivalFor(region);
                return i === 0 ? (
                  zones.map((zone) => (
                    <li class="fees__region fees__region--open box" data-region={region}>
                      <p class="fees__name">{zone.name}</p>
                      <p class="fees__facts">
                        <span class="docket__label">Fee</span>
                        <span class="fees__value">{feeText(zone.cost)}</span>
                        {arrives !== null && (
                          <>
                            <span class="docket__label">Arrives</span>
                            <span class="fees__value" data-timing>{arrives}</span>
                          </>
                        )}
                      </p>
                    </li>
                  ))
                ) : (
                  <li class="fees__region box" data-region={region}>
                    <details>
                      <summary class="fees__summary">
                        <span class="fees__name">{region}</span>
                        <span class="fees__facts">
                          <span class="docket__label">Fee</span>
                          <span class="fees__value">{feeRange(zones)}</span>
                          <span class="docket__label">Counties</span>
                          <span class="fees__value">{zones.length}</span>
                          {arrives !== null && (
                            <>
                              <span class="docket__label">Arrives</span>
                              <span class="fees__value" data-timing>{arrives}</span>
                            </>
                          )}
                        </span>
                      </summary>
                      <table class="zones">
                        <thead>
                          <tr>
                            <th scope="col">County</th>
                            <th scope="col">Fee per order</th>
                          </tr>
                        </thead>
                        <tbody>
                          {zones.map((zone) => (
                            <tr>
                              <td>{zone.name}</td>
                              <td class="zones__figure">{feeText(zone.cost)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </details>
                  </li>
                );
              })}
            </ul>
            <p class="page__body fees__note">
              Towns outside Nairobi County, such as Ruiru, Kitengela, Rongai or Ngong, take
              the fee of the county they are in.
            </p>
          </section>
        )
      }

      <Gap field="delivery.zones" />

      {
        hasReturns && (
          <>
            <hr class="page__hair" />
            <h2 class="page__sub">Returns</h2>
            <p class="page__body">
              Anything can be returned within {site.delivery.returnsWindowDays} days of
              arriving, {site.delivery.returnsCondition}.
            </p>
          </>
        )
      }

      <Gap field="delivery.returnsWindowDays" />
      <Gap field="delivery.returnsCondition" />

      <hr class="page__hair" />
      <h2 class="page__sub">Questions about delivery</h2>
      <p class="page__body page__reach">
        <a href={whatsappHref("WEB-DELIVERY")}>Message MomentAura on WhatsApp</a>
        <span>or</span>
        <a href={telHref()}>Call {phoneDisplay()}</a>
      </p>
      <p class="page__body">
        Every other way to reach a person is on the <a href="/contact">contact</a> page.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .page__inner {
    max-width: var(--max-width);
  }

  .page__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  .page__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-16);
  }

  .page__body {
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-block-end: var(--s-20);
  }

  .page__hair {
    border: 0;
    border-block-start: 1px solid var(--border);
    width: 100%;
    margin-block: var(--s-40);
  }

  .page__reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-8);
  }

  .page__reach a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  /* Figures in mono, area names in Archivo. The typeface switch is the signal
     that the reader is looking at a fact. */
  .zones {
    border-collapse: collapse;
    width: 100%;
    max-width: var(--measure);
  }

  .zones th {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    font-weight: var(--w-medium);
    text-align: start;
    padding-block-end: var(--s-12);
    border-block-end: 1px solid var(--border);
  }

  .zones td {
    font-size: var(--t-body-sm);
    text-align: start;
    padding-block: var(--s-12);
    border-block-end: 1px dashed var(--border);
  }

  /* One column, two from 640px. align-items: start, so opening one region
     does not stretch the closed box beside it to the same height. */
  .fees__grid {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-16);
    align-items: start;
  }

  @media (min-width: 640px) {
    .fees__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .fees__region {
    padding-inline: var(--s-20);
  }

  .fees__region--open {
    padding-block: var(--s-16);
  }

  /* The whole summary is the control, at a full thumb-sized height. The
     platform's disclosure marker stays: it is the only thing that says the box
     opens. */
  .fees__summary {
    display: list-item;
    min-height: var(--tap-target);
    padding-block: var(--s-16);
    cursor: pointer;
  }

  /* Region and zone names in Archivo; what they cost and when they arrive in
     mono, under the docket's labels. The typeface switch is the signal. */
  .fees__name {
    display: inline;
    font-size: var(--t-body-sm);
  }

  .fees__region--open .fees__name {
    display: block;
  }

  .fees__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 var(--s-20);
    margin-block-start: var(--s-8);
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    line-height: var(--lh-docket);
  }

  .fees__value {
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  .fees__region .zones {
    max-width: none;
    margin-block-end: var(--s-20);
  }

  .fees__note {
    margin-block-start: var(--s-20);
  }

  .zones__figure {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    font-variant-numeric: tabular-nums;
  }
</style>
