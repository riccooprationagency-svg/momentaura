---
// Delivery and returns.
//
// OMISSION, NOT A STATED ABSENCE. Where a fact does not exist the element is not
// rendered at all — no zone table, no returns heading, no sentence explaining
// that a zone table would go here. A page missing a section is honest. A page
// carrying "[areas]", "coming soon", or a paragraph apologising for the gap is a
// stub that shipped, and it tells a buyer the shop was assembled from a template
// and abandoned — which is precisely the suspicion this site exists to reduce.
//
// The absences are recorded in BUILD-ORDER section 10, with what each one needs,
// so they read as decisions rather than as things nobody noticed. The dev-only
// marker names the key in site.json; a production build never sees it.
//
// PAYMENT IS THE ONE SECTION THAT CAN BE WRITTEN IN FULL TODAY, because it
// describes what the code does rather than a fact only Ric holds.
import Base from "../layouts/Base.astro";
import Gap from "../components/Gap.astro";
import { site, known, feeText, phoneDisplay, telHref, whatsappHref, zonesByRegion } from "../lib/site";

const hasZones = known(site.delivery.zones);
const regions = zonesByRegion();
const hasDispatch = known(site.delivery.dispatchFrom);
// Both halves or neither. A window with no condition, or a condition with no
// window, is half a promise.
const hasReturns = known(site.delivery.returnsWindowDays) && known(site.delivery.returnsCondition);
---

<Base
  title="Delivery and returns — MomentAura"
  description="How orders are paid for, where they are sent from, and how returns work."
  system="light"
>
  <section class="page">
    <div class="wrap page__inner">
      <h1 class="page__heading">Delivery and returns</h1>

      <h2 class="page__sub">Paying</h2>
      <p class="page__body">
        Payment is by M-Pesa. At checkout you give a name and the phone number the
        payment should go through, and the payment itself is completed on the payment
        provider's own secure page — you are told before you are taken there, and you come
        back here when it is done.
      </p>
      <p class="page__body">
        <strong>No card details are ever entered on this site.</strong> There is no card
        form anywhere in it.
      </p>
      <p class="page__body">
        Nothing is charged until you confirm the payment yourself, and nothing is
        dispatched until that payment is confirmed. Prices are in Kenyan shillings and the
        price on the product page is the price of the item.
      </p>

      {
        hasDispatch && (
          <>
            <hr class="page__hair" />
            <h2 class="page__sub">Dispatch</h2>
            <p class="page__body">
              Every order is packed and sent from {site.delivery.dispatchFrom}.
            </p>
            <p class="page__body">
              Where a delivery date is given it is given as a date, not a number of days —
              at checkout, on your confirmation, and when you look an order up. A duration
              asks you to do the arithmetic yourself at the moment you are deciding
              whether to trust a commitment.
            </p>
          </>
        )
      }

      {
        /*
          The fee table, from site.json delivery.zones — the same rows the
          checkout select is built from and the server prices by, so the figure
          read here is the figure charged.

          One <details> per region, Nairobi first and open: it is where most
          orders go, and 48 rows in one table is a wall on a phone. Native
          disclosure, so every fee is readable with JavaScript off, and a
          browser's find-in-page opens a closed region to a match.

          No delivery time is stated, here or anywhere. None has been supplied
          for any county, and a duration nobody can hold the shop to is the
          kind of claim this page exists not to make.
        */
        hasZones && (
          <section id="fees" class="fees" aria-labelledby="fees-heading">
            <hr class="page__hair" />
            <h2 class="page__sub" id="fees-heading">Delivery fees</h2>
            <p class="page__body">
              One fee per order, not per item, set by the county the order is going to.
              Choose the county at checkout and the fee is added to the total before the
              M-Pesa prompt is sent.
            </p>
            {regions.map(({ region, zones }, i) => (
              <details class="fees__region" open={i === 0}>
                <summary class="fees__summary">{region}</summary>
                <table class="zones">
                  <thead>
                    <tr>
                      <th scope="col">County</th>
                      <th scope="col">Fee per order</th>
                    </tr>
                  </thead>
                  <tbody>
                    {zones.map((zone) => (
                      <tr>
                        <td>{zone.name}</td>
                        <td class="zones__figure">{feeText(zone.cost)}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </details>
            ))}
            <p class="page__body fees__note">
              Towns outside Nairobi County, such as Ruiru, Kitengela, Rongai or Ngong, take
              the fee of the county they are in.
            </p>
          </section>
        )
      }

      <Gap field="delivery.zones" />

      {
        hasReturns && (
          <>
            <hr class="page__hair" />
            <h2 class="page__sub">Returns</h2>
            <p class="page__body">
              Anything can be returned within {site.delivery.returnsWindowDays} days of
              arriving, {site.delivery.returnsCondition}.
            </p>
          </>
        )
      }

      <Gap field="delivery.returnsWindowDays" />
      <Gap field="delivery.returnsCondition" />

      <hr class="page__hair" />
      <h2 class="page__sub">Questions about delivery</h2>
      <p class="page__body page__reach">
        <a href={whatsappHref("WEB-DELIVERY")}>Message MomentAura on WhatsApp</a>
        <span>or</span>
        <a href={telHref()}>Call {phoneDisplay()}</a>
      </p>
      <p class="page__body">
        Every other way to reach a person is on the <a href="/contact">contact</a> page.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .page__inner {
    max-width: var(--max-width);
  }

  .page__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  .page__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-16);
  }

  .page__body {
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-block-end: var(--s-20);
  }

  .page__hair {
    border: 0;
    border-block-start: 1px solid var(--border);
    width: 100%;
    margin-block: var(--s-40);
  }

  .page__reach {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--s-8);
  }

  .page__reach a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  /* Figures in mono, area names in Archivo. The typeface switch is the signal
     that the reader is looking at a fact. */
  .zones {
    border-collapse: collapse;
    width: 100%;
    max-width: var(--measure);
  }

  .zones th {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    font-weight: var(--w-medium);
    text-align: start;
    padding-block-end: var(--s-12);
    border-block-end: 1px solid var(--border);
  }

  .zones td {
    font-size: var(--t-body-sm);
    text-align: start;
    padding-block: var(--s-12);
    border-block-end: 1px dashed var(--border);
  }

  .fees__region {
    border-block-end: 1px solid var(--border);
  }

  /* The whole row is the control, at a full thumb-sized height. The platform's
     disclosure marker stays: it is the only thing that says the row opens. */
  .fees__summary {
    display: list-item;
    min-height: var(--tap-target);
    padding-block: var(--s-12);
    font-size: var(--t-body-sm);
    cursor: pointer;
  }

  .fees__region .zones {
    margin-block-end: var(--s-20);
  }

  .fees__note {
    margin-block-start: var(--s-20);
  }

  .zones__figure {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    font-variant-numeric: tabular-nums;
  }
</style>
