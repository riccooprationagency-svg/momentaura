---
// Checkout. Name and phone, where it is going, an order summary with the
// delivery fee, and one button that sends an M-Pesa payment prompt to the phone
// number just entered.
//
// THE FEE ON THIS PAGE IS A PREVIEW. The cart reads it off the chosen option to
// fill the Delivery and Total lines and the button, so the buyer sees the
// figure before the prompt asks for it. The figure that is charged is computed
// again by functions/api/_order.js from the county key, and the M-Pesa prompt
// on the buyer's phone shows that one.
//
// NO CARD FIELD EXISTS HERE, and none may ever be added. M-Pesa is the only
// payment method this shop takes, and the prompt is completed on the buyer's
// own phone with their own PIN — nothing resembling a card or PIN field is
// ever rendered on this domain.
//
// Submitting this form does not leave the site. That is stated in prose above
// the button, because a buyer who has been trained by every other checkout to
// expect a redirect should not be left wondering whether the click did
// anything — /order-received is where the prompt's outcome actually shows up.
import Base from "../layouts/Base.astro";
import Button from "../components/Button.astro";
import Field from "../components/Field.astro";
import OrderHelp from "../components/OrderHelp.astro";
import CountyOptions from "../components/CountyOptions.astro";
import { products, price } from "../lib/products";
import { GATEWAY_NAME } from "../../functions/api/_daraja.js";
import { MAX_AREA, MAX_LANDMARK } from "../../functions/api/_order.js";
import { dispatchRule, timingGroups, listJoin } from "../lib/site";

/* The dispatch rule and arrival times, stated once under the county field.
   STATIC: it does not change when a county is chosen, because a per-county line
   would have to listen to the <select>, and that is the cart script's job and
   the cart script has no room. Grouped by identical timing rather than as
   "Nairobi" and "other counties", so a region with a different answer gets its
   own sentence. V18 fails the build if this paragraph is missing. */
const rule = dispatchRule();
const groups = timingGroups();

// Light, following the products it lists, exactly as /order does.
---

<Base
  title="Checkout — MomentAura"
  description={`Name, phone number, and a ${GATEWAY_NAME} payment prompt sent to your phone. Dispatched from Nairobi.`}
  system="light"
  index={false}
>
  <section class="checkout">
    <div class="wrap">
      <h1 class="checkout__heading">Checkout</h1>

      <!-- Ships as the empty state, and it is the honest one: a browser that
           cannot read storage has no order to check out. -->
      <p class="checkout__empty" data-order-empty>
        Nothing in your order yet. <a href="/">Start from the categories</a>.
      </p>

      <div class="checkout__grid" data-order-live hidden>
        <form class="checkout__form" id="checkout-form" data-checkout-form novalidate>
          <h2 class="checkout__sub">Where it is going</h2>

          <Field
            name="name"
            label="Name"
            autocomplete="name"
            required
            hint="The name the order is for."
          />

          <Field
            name="phone"
            label="Phone"
            type="tel"
            inputmode="tel"
            autocomplete="tel"
            required
            hint="M-Pesa sends the payment prompt to this number. Like 0712 345 678."
          />

          <Field
            name="email"
            label="Email"
            type="email"
            inputmode="email"
            autocomplete="email"
            hint="Only for a receipt. Leave it blank if you would rather not."
          />

          <!--
            Where it is physically going. The county is a native <select> of the
            fee table's keys, each label carrying its fee, so the figure is in
            front of the buyer before they choose and with JavaScript off. The
            server prices delivery from the key it posts and nothing else.
            Lengths match what functions/api/_order.js accepts.
          -->
          <Field
            name="county"
            label="County"
            select
            required
            hint="The delivery fee is per order, not per item. All fees are on the delivery page."
          >
            <CountyOptions />
          </Field>

          {
            rule !== null && groups.length > 0 && (
              <p class="checkout__timing" data-timing-summary>
                {rule.rule} Working days are {rule.workingDays}.{" "}
                {groups.map(({ regions, sentence }) => `${listJoin(regions)}: ${sentence[0].toLowerCase()}${sentence.slice(1)}`).join(" ")}
              </p>
            )
          }

          <Field
            name="area"
            label="Area or estate"
            autocomplete="address-level3"
            maxlength={MAX_AREA}
            required
            hint="Like Kilimani, or Kahawa Sukari."
          />

          <Field
            name="landmark"
            label="Landmark"
            maxlength={MAX_LANDMARK}
            required
            hint="A place a rider can find, e.g. a shop or stage."
          />

          <!--
            STATE WHAT HAPPENS BEFORE IT HAPPENS. Prose, above the button. Not
            a tooltip, not fine print under the fold, and not after the click.
          -->
          <p class="checkout__redirect">
            Submitting sends a {GATEWAY_NAME} payment prompt to the phone number above.
            Enter your PIN there to pay. You do not leave this site, and no card details
            are ever entered anywhere on it.
          </p>

          <!-- Filled and revealed by the cart when the server rejects the
               order as a whole — a gateway that is down, or a line that sold
               out between the order page and here. Field-level messages go
               under their own field instead. -->
          <p class="checkout__error" id="checkout-error" data-checkout-error role="alert" hidden></p>

          <div class="checkout__actions">
            <!-- data-pay is the label the cart extends with the total once a
                 county is chosen: "Pay with M-Pesa — KSh 900". Until then, and
                 with JavaScript off, it is the plain verb. -->
            <Button variant="filled" type="submit" data-checkout-submit data-pay={`Pay with ${GATEWAY_NAME}`}>
              Pay with {GATEWAY_NAME}
            </Button>
            <a class="checkout__back" href="/order">Back to your order</a>
          </div>
        </form>

        <aside class="checkout__summary" aria-labelledby="summary-heading">
          <h2 class="checkout__sub" id="summary-heading">Your order</h2>

          <ul class="summary__lines" role="list">
            {
              products.map((product) => (
                <li
                  class="summary__line"
                  data-line
                  data-slug={product.slug}
                  data-name={product.name}
                  data-price={product.price}
                  data-stock={product.stock}
                  hidden
                >
                  <span class="summary__name">{product.name}</span>
                  <span class="summary__qty">
                    <span data-qty>0</span> &times; {price(product.price)}
                  </span>
                  <span class="summary__amount" data-line-total />
                  {/* THE SIZE, on the line it sizes, for a product made in
                      sizes and no other. A native <select> that belongs to the
                      form by its id, so it posts as size-<slug> with the rest
                      of the fields and the cart script carries nothing for it:
                      the line is revealed by the same painter that reveals the
                      row, and its value never touches storage. The server
                      matches it against the product's own labels.
                      One size per product per order, because the order has one
                      line per product — see the PR for phase 4. */}
                  {product.sizes.length > 0 && (
                    <div class="summary__size">
                      <Field name={`size-${product.slug}`} label={`${product.name} size`} select required form="checkout-form">
                        <option value="" disabled selected>Choose a size</option>
                        {product.sizes.map((size) => <option value={size.label}>{size.label}</option>)}
                      </Field>
                    </div>
                  )}
                </li>
              ))
            }
          </ul>

          <hr class="checkout__hair" />

          <!--
            Subtotal, Delivery, Total. The first is the lines at catalogue
            prices; the other two wait for a county and say so until one is
            chosen, rather than showing a total that is missing a fee.
          -->
          <p class="summary__row">
            <span class="summary__total-label">Subtotal</span>
            <span class="summary__total-value" data-order-total>KSh 0</span>
          </p>
          <p class="summary__row">
            <span class="summary__total-label">Delivery</span>
            <span class="summary__total-value" data-order-fee>Choose a county</span>
          </p>
          <p class="summary__total">
            <span class="summary__total-label">Total</span>
            <span class="summary__total-value" data-order-due>Choose a county</span>
          </p>

          <p class="summary__terms">
            Dispatched from Nairobi. Delivery fees and how payment works are on the <a
              href="/delivery">delivery terms</a> page.
          </p>
        </aside>
      </div>

      <!-- Outside the live grid, so it is on the page in the empty state and
           with JavaScript off. A buyer whose prompt never arrived is the one
           who needs it, and that buyer may be looking at either. -->
      <div class="checkout__help">
        <OrderHelp source="WEB-CHECKOUT" />
      </div>
    </div>
  </section>
</Base>

<style>
  .checkout {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .checkout__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  /* Prose, not data: Archivo at body-sm, muted, like a field hint. */
  .checkout__timing {
    color: var(--fg-muted);
    font-size: var(--t-body-sm);
    max-width: var(--measure);
  }

  .checkout__help {
    margin-block-start: var(--s-40);
  }

  .checkout__empty {
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  .checkout__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--s-56);
    align-items: start;
  }

  .checkout__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-20);
  }

  .checkout__form {
    display: grid;
    gap: var(--s-28);
  }

  /* Prose. It is the sentence that stops the redirect being a surprise, so it
     is set as reading matter, not as a caption or a mono label. */
  .checkout__redirect,
  .checkout__error {
    color: var(--fg-muted);
    max-width: var(--measure);
  }

  .checkout__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-20);
  }

  .checkout__back {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .checkout__back:hover {
    color: var(--fg);
  }

  /* ---------- summary ---------- */

  .checkout__summary {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    padding: var(--s-20);
  }

  .summary__lines {
    list-style: none;
    display: grid;
    gap: var(--s-16);
  }

  .summary__line {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--s-8) var(--s-20);
    align-items: baseline;
  }

  .summary__size {
    grid-column: 1 / -1;
  }

  .summary__name {
    font-size: var(--t-body-sm);
  }

  .summary__qty {
    grid-column: 1;
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }

  .summary__amount {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    font-family: var(--font-mono);
    font-size: var(--t-body-sm);
    letter-spacing: var(--tr-docket);
    font-variant-numeric: tabular-nums;
  }

  .checkout__hair {
    border: 0;
    border-block-start: 1px dashed var(--border);
    width: 100%;
    margin-block: var(--s-20);
  }

  .summary__row,
  .summary__total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-20);
    font-family: var(--font-mono);
    letter-spacing: var(--tr-docket);
  }

  .summary__row {
    margin-block-end: var(--s-8);
  }

  .summary__total {
    border-block-start: 1px dashed var(--border);
    padding-block-start: var(--s-8);
  }

  .summary__total-label {
    font-size: var(--t-label);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  .summary__total-value {
    font-size: var(--t-body-sm);
    font-variant-numeric: tabular-nums;
  }

  .summary__terms {
    font-size: var(--t-caption);
    color: var(--fg-muted);
    margin-block-start: var(--s-20);
  }

  @media (min-width: 900px) {
    /* Form leads, summary sits beside it. The summary is what they are paying
       for, so it stays on screen while they type rather than above the fold
       they have already scrolled past. */
    .checkout__grid {
      grid-template-columns: 1fr var(--reveal-object);
    }
  }
</style>
