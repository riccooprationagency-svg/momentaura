---
// Homepage.
//
// Not present, each because the data behind it does not exist yet:
//   hero video       no footage
//   hero photograph  no real photography of stock we hold. A disclosed group
//                    render of existing products (site.json heroImage) stands in
//                    until there is
//   capacity notice  no production figure, no cut-off date
//   dispatch ledger  zero orders dispatched
//   testimonials     no reviews, and none until roughly twenty orders
//   story block      no portrait and no copy. A bracketed stub is a visible
//                    absence; an omission is not a claim
//
// None of these is a slot, a comment or an empty element. Each arrives when its
// data does. See BUILD-ORDER section 5.
import Base from "../layouts/Base.astro";
import DispatchRule from "../components/DispatchRule.astro";
import CampaignStrip from "../components/CampaignStrip.astro";
import CategoryTile from "../components/CategoryTile.astro";
import ProductReveal from "../components/ProductReveal.astro";
import Gallery from "../components/Gallery.astro";
import { heroImage, heroLegend } from "../lib/hero";
import { campaign, campaignLive, fullDate } from "../lib/campaign";
import { categories, firstIn, listed } from "../lib/products";
import { site } from "../lib/site";

// The categories are derived from products.json in one place now, so the tiles
// here and the pages they link to cannot drift apart. A tile renders only for a
// category that has a listed product, and shows that category's first one.
// Listed means photographed (src/lib/products.ts): nothing on this page is a
// kraft placeholder.

// Two reveals, not five. Enough to establish the rhythm. The first two listed
// products in catalogue order; fewer than two listed renders fewer.
const revealed = listed.slice(0, 2);
const stripLive = campaignLive();
const legend = heroLegend();

// Where the hero's one button goes. While the campaign is live it is the page the
// strip links to; otherwise the first category page. Never a typed product.
const cta = stripLive
  ? { href: "/black-november/", label: "Shop Black November" }
  : { href: `/${categories[0].slug}/`, label: "See the range" };
---

<Base
  title="MomentAura — apparel and accessories, Nairobi"
  description="Apparel and accessories made and dispatched from Nairobi. Prices in KSh, payment by M-Pesa."
>
  <!--
    The strip and the hero share one box, the height of the viewport less the
    nav, and the hero takes whatever the strip leaves. The strip is one row on a
    desktop and wraps to several on a phone, and CSS cannot read either, so the
    hero is never given a height that assumes one: it is given the remainder, and
    with no strip it is the whole box.
  -->
  <div class="first">
  <CampaignStrip />
  <!--
    Copy, the picture, then the legend, in that order in the document and on a
    phone. From 900px the copy and legend stack in the left column and the picture
    takes the right. The picture is the one group render in site.json, through
    Gallery, eager: it is the LCP element. Every figure in the legend is read from
    products.json; none is typed here.
  -->
  <section class="hero" data-system="dark">
    <div class="wrap hero__inner">
      <div class="hero__copy">
        <p class="hero__label">Nairobi &middot; Est 2026</p>
        <h1 class="hero__title">Wear the<br /><span class="hero__title-muted">moment</span></h1>
        <p class="hero__sentence">
          T-shirts, hoodies, sweatshirts and tracksuits. Pay with M-Pesa. Dispatched from Nairobi.
        </p>
        <dl class="hero__facts">
          {
            site.delivery.dispatchFrom && (
              <>
                <dt class="docket__label">Dispatch</dt>
                <dd class="docket__value--fact">{site.delivery.dispatchFrom}</dd>
              </>
            )
          }
          {
            stripLive && (
              <>
                <dt class="docket__label">Black November ends</dt>
                <dd>{fullDate(campaign.endsOn)}</dd>
              </>
            )
          }
        </dl>
        <p class="hero__action">
          <a class="hero__cta" href={cta.href}>{cta.label}<span aria-hidden="true"> &rarr;</span></a>
        </p>
      </div>

      {
        heroImage && (
          <div class="hero__picture">
            <Gallery image={heroImage} />
          </div>
        )
      }

      {
        legend.length > 0 && (
          <ul class="hero__legend">
            {legend.map((line) => (
              <li>
                <span class="hero__legend-lead">{line.lead}</span> <a class="hero__legend-link" href={line.href}>{line.name}</a>{" "}
                <span class:list={{ "hero__legend-pending": line.muted }}>{line.status}</span>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>
  </div>

  <div class="band" data-system="dark">
    <div class="wrap">
      <DispatchRule label="Nairobi" />
    </div>
  </div>

  <section class="band" data-system="light">
    <div class="wrap">
      <h2 class="section-heading">What is made here</h2>
      <div class="tiles">
        {categories.map((c) => (
          <CategoryTile slug={c.slug} name={c.name} line={c.line} product={firstIn(c.slug)!} />
        ))}
      </div>
    </div>
  </section>

  {
    /* Reveal 1 takes the product's own system. Reveal 2 runs a dark band under
       a light card, so the page alternates rather than presenting two identical
       light screens in sequence. The band is page rhythm; the card is still the
       product's own system and says nothing different about the product. */
    revealed.map((product, i) => (
      <ProductReveal product={product} band={i === 1 ? "dark" : undefined} />
    ))
  }
</Base>

<style>
  /* Ground and ink together, always. An element that sets data-system remaps
     --fg for its whole subtree, so painting the text without painting the
     ground leaves one system's ink on the other's canvas. V7 fails the build
     on the omission. */
  .first {
    display: flex;
    flex-direction: column;
    min-height: calc(var(--hero-height) - var(--s-56));
  }

  .hero {
    flex: 1 0 auto;
    min-height: var(--hero-min);
    display: flex;
    background-color: var(--bg);
    color: var(--fg);
    padding-block-start: var(--s-56);
  }

  /* Under 900px: one column, copy then picture then legend. minmax(0, 1fr) is the
     track that lets a child be capped by the container rather than stretching it. */
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--s-28);
    align-content: start;
    padding-block-end: var(--s-56);
  }

  .hero__label {
    display: flex;
    align-items: center;
    gap: var(--s-16);
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    line-height: var(--lh-docket);
    letter-spacing: var(--tr-docket);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* The dashed hairline that follows the label. */
  .hero__label::after {
    content: "";
    flex: 1;
    border-block-start: 1px dashed var(--border);
  }

  .hero__title {
    margin-block-start: var(--s-16);
    font-size: var(--t-display);
    line-height: var(--lh-display);
    text-transform: uppercase;
    font-weight: var(--w-medium);
  }

  .hero__title-muted {
    color: var(--fg-muted);
  }

  .hero__sentence {
    margin-block-start: var(--s-20);
    max-width: var(--hero-measure);
    font-size: var(--t-body-sm);
    line-height: var(--lh-ui);
    color: var(--fg-muted);
  }

  /* Docket register, two columns of label and value. The Dispatch value wears the
     docket's own fact class, the one V3 pins, so no new use of the accent exists
     here. The campaign date is plain ink: it is not on CLAUDE.md's list of
     checkable facts. */
  .hero__facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-8) var(--s-20);
    margin-block-start: var(--s-20);
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    line-height: var(--lh-docket);
    letter-spacing: var(--tr-docket);
  }

  .hero__facts dd {
    margin: 0;
  }

  .hero__facts .docket__label {
    text-transform: uppercase;
  }

  .hero__action {
    margin-block-start: var(--s-28);
  }

  /* One filled pill: Kraft Board fill, cream text, a 1px cream border. The hover
     changes the border colour and nothing else. */
  .hero__cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-target);
    padding-inline: var(--s-28);
    border-radius: var(--radius-button);
    background-color: var(--surface);
    color: var(--fg);
    border: 1px solid var(--fg);
    font-size: var(--t-label);
    font-weight: var(--w-medium);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    text-decoration: none;
    transition: border-color var(--hero-dur) var(--ease);
  }

  .hero__cta:hover {
    border-color: var(--fg-muted);
  }

  .hero__legend {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-8);
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    line-height: var(--lh-docket);
    letter-spacing: var(--tr-docket);
  }

  .hero__legend-lead,
  .hero__legend-pending {
    color: var(--fg-muted);
  }

  /* The product name is the link: ink, underlined, so it reads as one without the
     accent. Mono and the page's own tokens, the focus ring is global.css's. */
  .hero__legend-link {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  .hero__legend-link:hover {
    color: var(--fg-muted);
  }

  /* A status never breaks mid-figure: "KSh 6,200" stays one piece. */
  .hero__legend li > span:last-child {
    white-space: nowrap;
  }

  /* From 900px: copy and legend in the left column, centred together against the
     picture's full height by the two flexible rows around them; the picture spans
     all four rows, bottom-aligned and bleeding one gutter past the column edge. */
  @media (min-width: 900px) {
    .hero {
      padding-block-start: var(--s-80);
    }

    .hero__inner {
      grid-template-columns: var(--hero-columns);
      grid-template-rows: 1fr auto auto 1fr;
      column-gap: var(--s-28);
      row-gap: var(--s-28);
      padding-block-end: 0;
    }

    .hero__copy {
      grid-column: 1;
      grid-row: 2;
    }

    .hero__legend {
      grid-column: 1;
      grid-row: 3;
    }

    .hero__picture {
      grid-column: 2;
      grid-row: 1 / -1;
      align-self: end;
      margin-inline-end: calc(var(--gutter) * -1);
    }
  }

  /* ---------- the entrance ----------
     Once, on load, no script and nothing tied to scroll. A transition out of
     @starting-style, so no @keyframes (V6 bans them outside the campaign). Copy
     fades in 60ms apart: label, title, sentence, facts, button, legend. The
     picture fades and slides 16px in from the right. Opacity and transform only.
     A browser without @starting-style shows everything at rest. Reduced motion
     zeroes every duration, delay and shift in tokens.css, and the block below
     removes the transition outright as well. */
  .hero__copy > *,
  .hero__legend {
    transition: opacity var(--hero-dur) var(--ease);
  }

  .hero__copy > :nth-child(2) {
    transition-delay: calc(var(--hero-step) * 1);
  }

  .hero__copy > :nth-child(3) {
    transition-delay: calc(var(--hero-step) * 2);
  }

  .hero__copy > :nth-child(4) {
    transition-delay: calc(var(--hero-step) * 3);
  }

  .hero__copy > :nth-child(5) {
    transition-delay: calc(var(--hero-step) * 4);
  }

  .hero__legend {
    transition-delay: calc(var(--hero-step) * 5);
  }

  .hero__picture {
    transition:
      opacity var(--hero-image-dur) var(--ease),
      transform var(--hero-image-dur) var(--ease);
    transition-delay: var(--hero-image-delay);
  }

  @starting-style {
    .hero__copy > *,
    .hero__legend {
      opacity: 0;
    }

    .hero__picture {
      opacity: 0;
      transform: translateX(var(--hero-image-shift));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__copy > *,
    .hero__legend,
    .hero__picture {
      transition: none;
    }
  }

  /* The bands alternate systems and the alternation is the page's rhythm.
     No rules, no dividers, no separators between sections — a change of ground
     is the only separator this page uses.

     Full-bleed, with .wrap nested inside holding the content to --max-width.
     Painting --bg on .wrap instead would stop each ground at 1240px and leave
     the alternation floating in a column down the middle of the page. */
  .band {
    padding-block: var(--s-80);
    background-color: var(--bg);
    color: var(--fg);
  }

  .section-heading {
    font-size: var(--t-heading);
    line-height: var(--lh-display);
    text-transform: uppercase;
    font-weight: var(--w-medium);
    margin-block-end: var(--s-40);
  }

  .tiles {
    display: grid;
    gap: var(--s-20);
    grid-template-columns: repeat(auto-fit, minmax(var(--card-min), 1fr));
  }

</style>
