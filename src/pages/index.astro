---
// Homepage.
//
// Not present, each because the data behind it does not exist yet:
//   hero video       no footage
//   hero photograph  no real photography of stock we hold
//   capacity notice  no production figure, no cut-off date
//   dispatch ledger  zero orders dispatched
//   testimonials     no reviews, and none until roughly twenty orders
//   story block      no portrait and no copy. A bracketed stub is a visible
//                    absence; an omission is not a claim
//
// None of these is a slot, a comment or an empty element. Each arrives when its
// data does. See BUILD-ORDER section 5.
import Base from "../layouts/Base.astro";
import DispatchRule from "../components/DispatchRule.astro";
import CategoryTile from "../components/CategoryTile.astro";
import ProductReveal from "../components/ProductReveal.astro";
import { categories, products } from "../lib/products";

// The categories are derived from products.json in one place now, so the tiles
// here and the pages they link to cannot drift apart. Three exist. Six was
// written for a catalogue that still included watches and licensed panels, which
// the legal deletion removed.

// Two reveals, not five. Enough to establish the rhythm; five identical
// placeholder screens would be five identical placeholder screens.
const revealed = products.slice(0, 2);
---

<Base
  title="MomentAura — apparel and accessories, Nairobi"
  description="Apparel and accessories made and dispatched from Nairobi. Prices in KSh, payment by M-Pesa."
>
  <!--
    The wordmark at --t-hero is the image. There is still no photograph of stock
    we hold, and the three alternatives are each banned by name in CLAUDE.md —
    supplier photographs, stock lifestyle, AI-generated product imagery — so
    nothing legitimate could fill this frame. Type can, and the type is ours
    outright.

    That is why the hero is a full viewport again. The 70dvh it sat at was a
    hedge against emptiness, and at this size the letterforms occupy the frame
    edge to edge within the gutter, so there is no emptiness left to hedge
    against.

    When the shoot happens the photograph sits BEHIND these letterforms rather
    than replacing them: the mark stays at --t-hero, the image goes underneath,
    and the section keeps its height. It does not become a photograph with a
    caption over it. Nothing in this block changes but the addition of the
    image and its ground.
  -->
  <section class="hero" data-system="dark">
    <div class="wrap hero__inner">
      <p class="hero__line">Nairobi — apparel and accessories</p>
      <h1 class="hero__mark">MomentAura</h1>
    </div>
  </section>

  <div class="band" data-system="dark">
    <div class="wrap">
      <DispatchRule label="Nairobi" />
    </div>
  </div>

  <section class="band" data-system="light">
    <div class="wrap">
      <h2 class="section-heading">What is made here</h2>
      <div class="tiles">
        {categories.map((c) => (
          <CategoryTile slug={c.slug} name={c.name} line={c.line} />
        ))}
      </div>
    </div>
  </section>

  {
    /* Reveal 1 takes the product's own system. Reveal 2 runs a dark band under
       a light card, so the page alternates rather than presenting two identical
       light screens in sequence. The band is page rhythm; the card is still the
       product's own system and says nothing different about the product. */
    revealed.map((product, i) => (
      <ProductReveal product={product} band={i === 1 ? "dark" : undefined} />
    ))
  }
</Base>

<style>
  /* Ground and ink together, always. An element that sets data-system remaps
     --fg for its whole subtree, so painting the text without painting the
     ground leaves one system's ink on the other's canvas. V7 fails the build
     on the omission. */
  .hero {
    min-height: max(var(--hero-min), var(--hero-height));
    display: flex;
    align-items: flex-end;
    padding-block: var(--s-80);
    background-color: var(--bg);
    color: var(--fg);
  }

  .hero__inner {
    display: grid;
    gap: var(--s-16);
  }

  .hero__line {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    text-transform: uppercase;
    color: var(--fg-muted);
  }

  /* Type as the image. Weight 500, not the 600 the nav wordmark carries: at
     this size 600 closes the counters and the mark stops reading as letterforms
     and starts reading as a mass. CLAUDE.md caps the logo at 600 — it does not
     require it to be 600. Line-height 0.9 is what makes the stack read as solid
     form, and it matters more here than anywhere else on the site. */
  .hero__mark {
    font-size: var(--t-hero);
    line-height: var(--lh-display);
    text-transform: uppercase;
    font-weight: var(--w-medium);
  }

  /* The bands alternate systems and the alternation is the page's rhythm.
     No rules, no dividers, no separators between sections — a change of ground
     is the only separator this page uses.

     Full-bleed, with .wrap nested inside holding the content to --max-width.
     Painting --bg on .wrap instead would stop each ground at 1240px and leave
     the alternation floating in a column down the middle of the page. */
  .band {
    padding-block: var(--s-80);
    background-color: var(--bg);
    color: var(--fg);
  }

  .section-heading {
    font-size: var(--t-heading);
    line-height: var(--lh-display);
    text-transform: uppercase;
    font-weight: var(--w-medium);
    margin-block-end: var(--s-40);
  }

  .tiles {
    display: grid;
    gap: var(--s-20);
    grid-template-columns: repeat(auto-fit, minmax(var(--card-min), 1fr));
  }

</style>
