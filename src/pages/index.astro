---
// Temporary. Step 2 check page — nav and footer on an otherwise empty page,
// both viewports. Replaced wholesale by the real homepage at step 5.
//
// The heading, paragraph and docket stay because they prove the three type
// registers and the accent path still resolve through the shell.
import Base from "../layouts/Base.astro";
---

<Base title="MomentAura — foundation">
  <div class="wrap">
    <h1>Foundation</h1>

    <p class="prose">
      Text renders before any image completes. This paragraph is the only
      conversational voice on the site, and it is the one place the type goes
      mixed case.
    </p>

    <dl class="docket">
      <dt class="docket__label">Contents</dt>
      <dd class="docket__value">Layout shell, no components yet</dd>
      <dt class="docket__label">Dispatch</dt>
      <dd class="docket__value docket__value--fact">Nairobi</dd>
      <dt class="docket__label">Status</dt>
      <dd class="docket__value">Step 2 of 11</dd>
    </dl>
  </div>
</Base>
