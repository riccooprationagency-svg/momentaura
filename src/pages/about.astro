---
// About.
//
// THE HARDEST PAGE TO WRITE HONESTLY WITH NOTHING TO WRITE FROM, and the one
// most likely to be padded, because an About page with no person in it feels
// like an omission that ought to be covered. That instinct is the enemy here.
// CLAUDE.md bans "founded on a passion for" and "born from a love of" by name
// precisely because they are what gets written when there is nothing to say —
// and a buyer arriving suspicious reads warmth with no facts in it as a shop
// with something to hide.
//
// The name, the photograph and the area are the whole point of this page and all
// three are null. So the page says what can be checked — what is sold, where it
// is sent from, how the shop behaves — and states the absence of the rest in one
// line instead of decorating around it.
//
// A real photograph, when it exists, moves this page to the dark system. Until
// then it is light, like every other page over a placeholder.
import Base from "../layouts/Base.astro";
import Gap from "../components/Gap.astro";
import { site, known } from "../lib/site";

const { name, photo, area } = site.owner;
const hasName = known(name);
const hasArea = known(area);
const hasPhoto = known(photo);
---

<Base
  title="About — MomentAura"
  description="Who makes and sends these orders, and where from."
  system="light"
>
  <section class="page">
    <div class="wrap page__inner">
      <h1 class="page__heading">About</h1>

      {
        hasPhoto ? (
          <img
            class="about__portrait"
            src={photo}
            alt={hasName ? `${name}, who packs and sends MomentAura orders` : "The person who packs and sends MomentAura orders"}
            width="600"
            height="800"
            loading="lazy"
            decoding="async"
          />
        ) : (
          /* No portrait, and no grey silhouette standing in for one. CLAUDE.md:
             no AI-generated people, no stock, no blank mockup presented as the
             real thing. An honest absence beats a dishonest face. */
          <p class="page__body">
            There is no photograph here yet. There will be a real one of a real person, or
            none — no stock image and nothing generated.
          </p>
        )
      }

      <Gap field="owner.photo" />

      {
        hasName ? (
          <p class="page__body">
            MomentAura is run by {name}
            {hasArea ? `, from ${area}` : ""}. Orders are packed and sent by hand.
          </p>
        ) : (
          <p class="page__body">
            The name of the person who packs and sends these orders is not published here
            yet. It will be a real name.
          </p>
        )
      }

      <Gap field="owner.name" />
      <Gap field="owner.area" />

      <hr class="page__hair" />

      <h2 class="page__sub">What this shop sells</h2>
      <p class="page__body">
        Apparel and accessories — t-shirts, hoodies, sweatshirts, bags, necklaces. Prices
        are in Kenyan shillings and are always on the page. Payment is by M-Pesa.
      </p>

      <h2 class="page__sub">How it behaves</h2>
      <p class="page__body">
        Everything sent from {site.delivery.dispatchFrom}. Nothing is dispatched before
        the payment is confirmed. A product that cannot be sent says so on its own page
        rather than quietly disappearing, and a sold-out item stays visible instead of
        being hidden.
      </p>
      <p class="page__body">
        There are no reviews on this site, because nobody has left one yet. There is no
        countdown, no "only two left", and no stock figure that is not real. When there is
        nothing true to say, the page says nothing.
      </p>
    </div>
  </section>
</Base>

<style>
  .page {
    background-color: var(--bg);
    color: var(--fg);
    padding-block: var(--s-56) var(--s-80);
  }

  .page__inner {
    max-width: var(--max-width);
  }

  .page__heading {
    font-size: var(--t-heading);
    margin-block-end: var(--s-40);
  }

  .page__sub {
    font-size: var(--t-label);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    margin-block-end: var(--s-16);
  }

  .page__body {
    color: var(--fg-muted);
    max-width: var(--measure);
    margin-block-end: var(--s-20);
  }

  .page__hair {
    border: 0;
    border-block-start: 1px solid var(--border);
    width: 100%;
    margin-block: var(--s-40);
  }

  /* One crop, same 3:4 as every product. */
  .about__portrait {
    display: block;
    width: 100%;
    max-width: var(--reveal-object);
    height: auto;
    border-radius: var(--radius-surface);
    margin-block-end: var(--s-28);
  }
</style>
