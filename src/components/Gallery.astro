---
// Every photograph on this site goes through here, and so does every absence of
// one. That is the point of the component: the two-system rule and the honest
// placeholder are one decision, made in one file, rather than the same ternary
// copied into a card, a reveal and a product page — which is what it was, three
// times, until the array landed.
//
// ---------- one placeholder, never four ----------
//
// photos.length === 0 renders exactly one .photo-pending. Not one per photo the
// product might one day have, and not one per rendition. Four kraft blocks stacked
// down a product page announce the same absence four times and read as a broken
// page rather than an honest one, which inverts the only reason the placeholder
// exists. The absence is one fact. It is stated once.
//
// ---------- detail, and why it defaults to off ----------
//
// Same prop, same default and same reasoning as Docket's `detail`: off unless a
// surface asks. On it renders every photograph, the first eager at high fetch
// priority because it is the LCP element of a product page. Off it renders the
// first photograph only, lazily.
//
// The default is the load-bearing part. A card in a grid of nine that forgot to
// opt out would otherwise pull nine galleries of eager full-width images over a
// metered connection, and nothing on the page would look wrong while it happened.
// A surface that forgets to opt in shows one lazy image, which costs nothing.
//
// ---------- the row swipes, and this reverses a decision ----------
//
// Until step 13 the CSS below said "a stack, never a carousel", on two grounds:
// a carousel needs a script, and it hides photographs behind an interaction on
// the page where a buyer is trying to see all of them. The first ground no
// longer holds — scroll-snap does the whole job in CSS, and the swipe costs zero
// bytes of JavaScript. The second is answered by the thumbnail strip: every
// photograph is still on the page at once, at 56px, and the strip is what tells
// a buyer there are four rather than leaving them to find out by dragging. The
// carousel this file refused was the kind that hides its own length.
import { systemFor, type Product } from "../lib/products";

interface Props {
  product: Product;
  detail?: boolean;
}

const { product, detail = false } = Astro.props;

const system = systemFor(product);
const shown = detail ? product.photos : product.photos.slice(0, 1);

/* The row scrolls and the strip appears only where there is a second photograph
   to reach. A strip of one is a control that does nothing, and a snap container
   with a single child is a scroller with nowhere to go. Cards are never
   swipeable for the same reason they are never eager: they show one image by
   design, and `shown` is already sliced to it. */
const swipeable = shown.length > 1;

/* ---------- deriving the other five URLs ----------
 *
 * products.json records one path per photograph, the 800px WebP. The other five
 * renditions are the same name with a different width and a different extension,
 * so they are derived here rather than stored — five stored paths are five
 * chances for one of them to be wrong in a way nothing reads until a buyer
 * loads the page.
 *
 * These widths must match WIDTHS in scripts/images.mjs. They are duplicated on
 * purpose rather than shared through a module: the two files are a .astro and a
 * hand-run .mjs, and threading a constant between them buys less than the check
 * that already covers the failure. verify.mjs V14 resolves every URL this
 * component emits against what is actually in dist/, so a width here that the
 * script never wrote fails the build rather than 404ing at a buyer.
 */
const RENDITIONS = [400, 800, 1200];
const NAMED = /^(\/img\/.+)-(\d+)\.([0-9a-f]{8})\.webp$/;

const parse = (src: string): RegExpExecArray => {
  const parsed = NAMED.exec(src);
  if (!parsed) {
    throw new Error(
      `products.json photo src "${src}" is not a name scripts/images.mjs would have ` +
        `written. Expected /img/<slug>-<n>-800.<hash>.webp. Never hand-edit the photos array.`
    );
  }
  return parsed;
};

const srcsetFor = (src: string, ext: "avif" | "webp"): string => {
  const [, stem, , hash] = parse(src);
  return RENDITIONS.map((w) => `${stem}-${w}.${hash}.${ext} ${w}w`).join(", ");
};

/* ---------- the thumbnail's one rendition ----------
 *
 * A 56px thumbnail is offered the 400px file and nothing else. Deliberately not
 * a srcset: V4 charges a page for the largest WebP candidate an element offers,
 * so a thumbnail carrying all three widths would bill this page three more times
 * for a 1200px file no device would ever fetch for a 56px box — and the whole
 * point of that rule is that the budget reads what a phone actually pays. The
 * smallest rendition is already seven times wider than the box, which covers a
 * 3x screen with room to spare.
 */
const thumbFor = (src: string): string => {
  const [, stem, , hash] = parse(src);
  return `${stem}-400.${hash}.webp`;
};

/* ---------- sizes ----------
 *
 * How wide the image will actually be rendered, so the browser can pick a
 * rendition before it has any layout. It is the only way srcset does anything at
 * all: without it the browser assumes 100vw and fetches the largest file every
 * time, on the metered mobile connections this site is built for.
 *
 * These are the two layouts this component lands in, read off the grids in
 * [slug].astro, ProductReveal.astro and [category].astro. They round up. An
 * over-estimate costs bytes on one image; an under-estimate puts a soft
 * photograph on the page where a buyer is deciding whether the shop is real, and
 * of the two only one of them is recoverable by looking harder.
 *
 * V2b exempts these for the same reason it exempts a media prelude: a
 * media-condition list is the one grammar var() does not resolve in, and this
 * is the only other place on the site that has one. The breakpoints below are
 * the three declared at the top of tokens.css — read and change them there.
 */
const SIZES = detail
  ? "(min-width: 1340px) 496px, (min-width: 900px) 38vw, (min-width: 641px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
  : "(min-width: 1340px) 400px, (min-width: 900px) 30vw, (min-width: 641px) 46vw, calc(100vw - 2.5rem)";
---

<div class="gallery">
  {
    system === "light" ? (
      /* One block. See the note at the top of this file. */
      <div class="photo-pending" aria-hidden="true">
        {product.name}
      </div>
    ) : (
      <div
        class="gallery__row"
        data-gallery={swipeable ? "" : undefined}
        role={swipeable ? "group" : undefined}
        aria-label={swipeable ? `${product.name}, ${shown.length} photographs` : undefined}
      >
        {shown.map((photo, i) => {
          /* Eager and high priority for the first image of a detail view only —
             it is above the fold and the largest thing on the page, so it is the
             LCP candidate. Everything else is below the fold, which is where
             CLAUDE.md's lazy rule applies, and that includes the first image of a
             card or a homepage reveal: both sit under a 70dvh hero.

             In a swipe row "below the fold" means beside it rather than under it,
             and lazy is if anything more clearly right: photographs two to four
             are off-screen until a swipe or a thumbnail reaches them. */
          const lead = detail && i === 0;

          return (
            <picture class="gallery__frame">
              <source type="image/avif" srcset={srcsetFor(photo.src, "avif")} sizes={SIZES} />
              <source type="image/webp" srcset={srcsetFor(photo.src, "webp")} sizes={SIZES} />
              <img
                class="gallery__img"
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading={lead ? "eager" : "lazy"}
                fetchpriority={lead ? "high" : undefined}
                decoding="async"
              />
            </picture>
          );
        })}
      </div>
    )
  }

  {
    /* The strip states the count. Its buttons are an enhancement on top of a row
       that already swipes and already scrolls without them, so with the script
       absent — or still waiting on requestIdleCallback — every photograph is
       still reachable and nothing here is load-bearing.

       The image inside each button is alt="", because the button already carries
       the name. Four copies of a written alt read back to back says the same
       sentence four times to the one person who cannot see the strip it is
       describing. */
    swipeable && (
      <ul class="gallery__thumbs">
        {shown.map((photo, i) => (
          <li>
            <button
              type="button"
              class="gallery__thumb"
              data-gallery-thumb
              aria-current={i === 0 ? "true" : "false"}
              aria-label={`Photograph ${i + 1} of ${shown.length}`}
            >
              <img
                src={thumbFor(photo.src)}
                alt=""
                width={400}
                height={Math.round((photo.height / photo.width) * 400)}
                loading="lazy"
                decoding="async"
              />
            </button>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .gallery {
    display: grid;
    gap: var(--s-12);
  }

  /* ---------- swipe, with no script ----------
     scroll-snap does on the compositor what a carousel library does in
     JavaScript, and it keeps working while the one script this site ships is
     still waiting on requestIdleCallback. Touch swipes it natively; a trackpad
     and a scrollbar reach it on desktop, which is why overflow is auto rather
     than hidden.

     No gap between frames, deliberately. The snap offset of photograph i is then
     exactly i scroller-widths, which is the arithmetic cart.ts does to scroll
     the row — a gap would put every jump progressively further out of true, and
     correcting for it costs bytes in a file with a hard ceiling. Mandatory
     snapping means two frames are only ever adjacent mid-drag anyway.

     The row names no scroll behaviour at all, and V6 is right to refuse the
     animated one — the check reads this comment too, so the property is not
     spelled out here. An animated jump is the site moving the viewport on the
     buyer's behalf, which is the scroll-jacking CLAUDE.md bans, and it lands
     worst exactly where this is used: a mid-range phone, where the tween drops
     frames. A thumbnail tap cuts straight to its photograph. That also leaves no
     motion here for prefers-reduced-motion to reduce, which is the cheapest way
     to respect it — cart.ts sets scrollLeft and never names a behaviour. */
  .gallery__row {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
  }

  .gallery__frame {
    flex: 0 0 100%;
    scroll-snap-align: start;
    /* One photograph per swipe. Without this a fast drag skims past two or three,
       which on a four-photograph product is most of the shoot. */
    scroll-snap-stop: always;
  }

  /* One 3:4 crop, everywhere. The ratio is stated in CSS as well as in the
     width and height attributes so the box is reserved even if a rendition
     fails to load — a 404 image with no ratio collapses the column and moves
     everything under it, which is the layout shift the attributes exist to
     prevent, arriving by the other door. */
  .gallery__img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-surface);
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---------- the strip ---------- */

  .gallery__thumbs {
    display: flex;
    gap: var(--s-8);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --s-56 is 56px, over the 44px touch minimum on the narrow axis; the 3:4 crop
     makes the target 56 by 75. A border, never a shadow, and never the accent —
     the accent means "you can check this", and which photograph is on screen is
     not a fact about the product. */
  .gallery__thumb {
    display: block;
    width: var(--s-56);
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-surface);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  .gallery__thumb[aria-current="true"] {
    border-color: var(--fg);
  }

  .gallery__thumb img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    width: 100%;
    height: auto;
    display: block;
  }
</style>
