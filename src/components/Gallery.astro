---
// Every photograph on this site goes through here, and so does every absence of
// one. That is the point of the component: the two-system rule and the honest
// placeholder are one decision, made in one file, rather than the same ternary
// copied into a card, a reveal and a product page — which is what it was, three
// times, until the array landed.
//
// ---------- one placeholder, never four ----------
//
// photos.length === 0 renders exactly one .photo-pending. Not one per photo the
// product might one day have, and not one per rendition. Four kraft blocks stacked
// down a product page announce the same absence four times and read as a broken
// page rather than an honest one, which inverts the only reason the placeholder
// exists. The absence is one fact. It is stated once. That is also why `last`
// below renders nothing at all for a product with no photographs: the product
// page has already spent its one placeholder in the object column.
//
// ---------- detail, and why it defaults to off ----------
//
// Same prop, same default and same reasoning as Docket's `detail`: off unless a
// surface asks. On, it renders every photograph, the first eager at high fetch
// priority because it is the LCP element of a product page. Off, it renders the
// first photograph only, lazily.
//
// The default is the load-bearing part. A card in a grid of nine that forgot to
// opt out would otherwise pull nine galleries of eager full-width images over a
// metered connection, and nothing on the page would look wrong while it happened.
// A surface that forgets to opt in shows one lazy image, which costs nothing.
//
// ---------- hero, and why it defaults to off ----------
//
// The homepage hero is the one place outside a product page where a photograph
// is the largest element in the first screen, so it is the LCP candidate there
// and has to load like one: eager, high fetch priority. `hero` asks for exactly
// that and for a `sizes` that matches the hero's own box, and for nothing else.
// It does not switch, it does not add a strip, and it never touches the caption:
// a render under the hero prints the same line, in the same register, as it does
// on every other surface.
//
// Same reasoning as `detail`, and the same default. Off, the first photograph is
// lazy. A surface that forgets to ask costs a late image; a surface that asks by
// accident costs an eager full-width fetch on a page that did not need one. Only
// src/pages/index.astro passes it.
//
// ---------- the strip, and why it has no script ----------
//
// With two or more photographs a detail view shows one at a time, chosen from a
// strip of thumbnails. The choice is a radio group: one visually hidden radio
// per photograph, one <label> per thumbnail, and the main image shown by
// :checked. The browser supplies the rest — click, tap, Tab into the group and
// arrow keys between photographs — with no JavaScript, so the cart stays the
// only script on the site and its byte budget is untouched. The attempt that
// used a script (closed PR #12) is what broke that budget.
//
// The radios come first in the markup so a sibling selector can reach both the
// main image and the thumbnail from them. :has() would allow any order, but it
// is missing from older Android browsers, and on those every main image would
// stay hidden. Sibling selectors have worked everywhere for twenty years.
//
// CSS cannot count, so there is one selector row per position, up to SWITCH_MAX.
// A product with more photographs than that fails the build here rather than
// shipping a strip whose seventh thumbnail does nothing.
//
// A hidden main image is lazy and display: none, so the browser does not fetch
// it until its thumbnail is chosen. The buyer pays for the photograph they look
// at, plus a 400px thumbnail of each of the others.
import { systemFor, type Product } from "../lib/products";
import { HERO_MAX } from "../lib/hero";

interface Props {
  product: Product;
  detail?: boolean;
  /** The product page's second-row photograph: the last one, lazily, and
   *  nothing at all for a product with no photographs. */
  last?: boolean;
  /** The homepage hero's lead photograph: eager, high priority, sized to the
   *  hero's box. Off unless the hero asks. */
  hero?: boolean;
  /** The Black November strip renders above the hero, so the hero photograph
   *  is the narrower --hero-image-width-strip. Off unless the homepage says so,
   *  and only read together with `hero`. */
  strip?: boolean;
}

const { product, detail = false, last = false, hero = false, strip = false } = Astro.props;

const system = systemFor(product);
const photos = product.photos;

/* Must match the number of selector rows in the <style> below. */
const SWITCH_MAX = 6;
const switching = detail && !last && photos.length >= 2;

if (switching && photos.length > SWITCH_MAX) {
  throw new Error(
    `Gallery: "${product.slug}" has ${photos.length} photographs and the strip switches at most ` +
      `${SWITCH_MAX}. Add selector rows to src/components/Gallery.astro and raise SWITCH_MAX, or ` +
      `drop a photograph with scripts/images.mjs.`
  );
}

/* The hero shows up to HERO_MAX photographs, in order, and HERO_MAX is a ceiling,
   not a target: one photograph is one image, exactly as before this prop learned
   to show more. */
const shown = last
  ? photos.slice(-1)
  : detail
    ? photos
    : hero
      ? photos.slice(0, HERO_MAX)
      : photos.slice(0, 1);

/* Two or more hero photographs: a row of slides, each with its own caption. One
   photograph keeps the plain markup below, so the one-image hero is unchanged. */
const heroRow = hero && !detail && !last && shown.length > 1;

/* ---------- deriving the other five URLs ----------
 *
 * products.json records one path per photograph, the 800px WebP. The other five
 * renditions are the same name with a different width and a different extension,
 * so they are derived here rather than stored — five stored paths are five
 * chances for one of them to be wrong in a way nothing reads until a buyer
 * loads the page.
 *
 * These widths must match WIDTHS in scripts/images.mjs. They are duplicated on
 * purpose rather than shared through a module: the two files are a .astro and a
 * hand-run .mjs, and threading a constant between them buys less than the check
 * that already covers the failure. verify.mjs V14 resolves every URL this
 * component emits against what is actually in dist/, so a width here that the
 * script never wrote fails the build rather than 404ing at a buyer.
 */
const RENDITIONS = [400, 800, 1200];
const NAMED = /^(\/img\/.+)-(\d+)\.([0-9a-f]{8})\.webp$/;

const parse = (src: string): [string, string] => {
  const parsed = NAMED.exec(src);
  if (!parsed) {
    throw new Error(
      `products.json photo src "${src}" is not a name scripts/images.mjs would have ` +
        `written. Expected /img/<slug>-<n>-800.<hash>.webp. Never hand-edit the photos array.`
    );
  }
  return [parsed[1], parsed[3]];
};

const srcsetFor = (src: string, ext: "avif" | "webp"): string => {
  const [stem, hash] = parse(src);
  return RENDITIONS.map((w) => `${stem}-${w}.${hash}.${ext} ${w}w`).join(", ");
};

/* A desktop thumbnail is --thumb-width, 96px, 288 device pixels on a 3x screen,
   so the 400px rendition covers it. A phone tile is a third of the row, about
   110px, and half of it with two photographs, about 170px: 330 and 510 device
   pixels at 3x, which the 400px file stretches slightly on the two-photograph
   product. Offering only that one keeps the browser from fetching a 1200px file
   into a tile, and keeps V4 from charging the page for one. No new file is made
   for the larger tile. */
const thumbOf = (src: string, ext: "avif" | "webp"): string => {
  const [stem, hash] = parse(src);
  return `${stem}-${RENDITIONS[0]}.${hash}.${ext}`;
};

/* ---------- sizes ----------
 *
 * How wide the image will actually be rendered, so the browser can pick a
 * rendition before it has any layout. It is the only way srcset does anything at
 * all: without it the browser assumes 100vw and fetches the largest file every
 * time, on the metered mobile connections this site is built for.
 *
 * Read off the grids in [slug].astro, ProductReveal.astro and [category].astro.
 * The arithmetic, because the previous version of this comment got it wrong:
 * .wrap is 1240px wide INCLUDING its two 32px gutters, so the content box stops
 * growing at 1176px, and it stops at a 1240px viewport, not 1340. A 40% column
 * of 1176 is 471px. Between 900 and 1240 it is 40% of (100vw - 64px), which is
 * under 40vw, so 40vw rounds up. Below 900 the page is one column: 100vw less
 * two gutters, 4rem above 640 and 2.5rem below.
 *
 * The strip does not take from the main image. The page widens its object
 * column by the strip's width when there is one, so the photograph is the same
 * size with or without thumbnails beside it.
 *
 * The second-row photograph sits in the other column: 1176 - 471 - 108 (strip
 * and its gap) - 56 (column gap) = 541px at the cap, and under 60vw below it.
 * Below 900 it is not displayed, and a lazy image that is display: none is not
 * fetched, so the value there is never used.
 *
 * With the Black November strip above the hero the box is --hero-image-width-strip
 * instead, 2.75rem less tall, and `strip` selects the matching sizes.
 *
 * The hero's box is --hero-image-width in tokens.css, clamp(9rem, (100dvh -
 * 26rem) * 0.75, 28rem), held inside the column by max-width: 100%. sizes
 * follows the same box: from 640 the column is wider than the cap, so the clamp
 * alone is the width; below it the column, the viewport less two 1.25rem
 * gutters, can be narrower, so the smaller of the two is. sizes does not take
 * dvh, so it uses vh, which is never shorter than dvh: the slot it reports is the
 * box or a little larger, and an over-estimate costs bytes on one image where an
 * under-estimate would put a soft render at the top of the site. The condition
 * is the first declared breakpoint, and a media condition is what V2b exempts
 * the lengths beside it for; here it is also a real difference between the two
 * branches, not a decoration. The clamp is written twice because V2b reads a
 * string one line at a time.
 *
 * They round up. An over-estimate costs bytes on one image; an under-estimate
 * puts a soft photograph on the page where a buyer is deciding whether the shop
 * is real, and of the two only one of them is recoverable by looking harder.
 *
 * V2b exempts these for the same reason it exempts a media prelude: a
 * media-condition list is the one grammar var() does not resolve in. The
 * breakpoints are the three declared at the top of tokens.css — read and change
 * them there.
 */
/* The hero row (two or more photographs). Each image is a slide of
   --hero-image-width, the same height-derived box as the single photograph, so
   the row costs the page no more height than one image did. Two regimes, using
   only the declared breakpoints:
     900px and up    `cols` equal columns in a column 100vw less two 2rem
                     gutters, less `gaps` --s-16 gaps: (100vw - (4 + gaps)rem) / cols,
                     with cols and gaps taken from shown.length, never from a fixed
                     three. Above 1240px the real column stops growing at 1176px
                     while 100vw keeps going, so this runs wide there. That is
                     safe: the height clamp is the smaller of the two on any screen
                     that wide, and an estimate that is too wide only fetches a
                     larger file, never a softer one.
     under 900px     one scrolling row, a slide at most 80% of the column
                     (--hero-slide-share, here as 0.8), the column being 100vw less
                     two gutters, 2rem from 640px and 1.25rem under it
   Each is the smaller of that and the height clamp, which is the box the CSS
   uses. Rounded up, for the reason above. */
const cols = shown.length;
const gaps = cols - 1;
/* Both hero widths are written out in full, one string per line with its media
   condition, because V2b reads a line at a time and exempts a length only beside
   the condition it belongs to, and because sizes cannot read a custom property.
   The strip's is --hero-image-width-strip: the same clamp with --tap-target (44px,
   2.75rem) taken off the height. Keep the pair in step with tokens.css. */
const SIZES = last
  ? "(min-width: 1240px) 541px, 60vw"
  : heroRow && strip
    ? `(min-width: 900px) min(clamp(9rem, calc((100vh - 26rem - 2.75rem) * 0.75), 28rem), calc((100vw - ${4 + gaps}rem) / ${cols})), ` +
      "(min-width: 640px) min(clamp(9rem, calc((100vh - 26rem - 2.75rem) * 0.75), 28rem), calc((100vw - 4rem) * 0.8)), min(clamp(9rem, calc((100vh - 26rem - 2.75rem) * 0.75), 28rem), calc((100vw - 2.5rem) * 0.8))"
    : heroRow
      ? `(min-width: 900px) min(clamp(9rem, calc((100vh - 26rem) * 0.75), 28rem), calc((100vw - ${4 + gaps}rem) / ${cols})), ` +
        "(min-width: 640px) min(clamp(9rem, calc((100vh - 26rem) * 0.75), 28rem), calc((100vw - 4rem) * 0.8)), min(clamp(9rem, calc((100vh - 26rem) * 0.75), 28rem), calc((100vw - 2.5rem) * 0.8))"
  : hero && strip
    ? "(min-width: 640px) clamp(9rem, calc((100vh - 26rem - 2.75rem) * 0.75), 28rem), min(clamp(9rem, calc((100vh - 26rem - 2.75rem) * 0.75), 28rem), calc(100vw - 2.5rem))"
    : hero
      ? "(min-width: 640px) clamp(9rem, calc((100vh - 26rem) * 0.75), 28rem), min(clamp(9rem, calc((100vh - 26rem) * 0.75), 28rem), calc(100vw - 2.5rem))"
      : detail
        ? "(min-width: 1240px) 471px, (min-width: 900px) 40vw, (min-width: 641px) calc(100vw - 4rem), calc(100vw - 2.5rem)"
        : "(min-width: 1340px) 400px, (min-width: 900px) 30vw, (min-width: 641px) 46vw, calc(100vw - 2.5rem)";

const group = `photo-${product.slug}`;

/* A render is shown as a render. The line sits under the image on every surface
   that shows one, detail or not, and nothing about layout shortens or hides it
   (CLAUDE.md, Rendered imagery). Prose, so Archivo and never mono. */
const render = product.photoKind === "render";
const CAPTION = "Studio render. Not a photograph of the garment.";
---

{
  system === "light" ? (
    /* One block, and none at all in the second row. See the note at the top. */
    !last && (
      <div class="gallery">
        <div class="photo-pending" aria-hidden="true">
          {product.name}
        </div>
      </div>
    )
  ) : switching ? (
    <div class="gallery gallery--switch">
      {photos.map((_, i) => (
        <input
          class="gallery__radio sr-only"
          type="radio"
          name={group}
          id={`${group}-${i + 1}`}
          checked={i === 0}
        />
      ))}

      <div class="gallery__main">
        {photos.map((photo, i) => (
          <div class="gallery__frame">
            <picture class="gallery__slide">
              <source type="image/avif" srcset={srcsetFor(photo.src, "avif")} sizes={SIZES} />
              <source type="image/webp" srcset={srcsetFor(photo.src, "webp")} sizes={SIZES} />
              <img
                class="gallery__img"
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading={i === 0 ? "eager" : "lazy"}
                fetchpriority={i === 0 ? "high" : undefined}
                decoding="async"
              />
            </picture>
            {render && <p class="gallery__caption">{CAPTION}</p>}
            {/* A fact about the page, so mono and muted, never the accent. Each
                frame carries its own, which is how the CSS switch changes it with
                the picture: no script. Only here, so only with two or more. */}
            <p class="gallery__count">{`Angle ${i + 1} of ${photos.length}`}</p>
          </div>
        ))}
      </div>

      <div
        class:list={["gallery__thumbs", { "gallery__thumbs--two": photos.length === 2 }]}
        role="group"
        aria-label="Photographs"
      >
        {photos.map((photo, i) => (
          <label class="gallery__thumb" for={`${group}-${i + 1}`}>
            <picture>
              <source type="image/avif" srcset={thumbOf(photo.src, "avif")} />
              <img
                class="gallery__thumb-img"
                src={thumbOf(photo.src, "webp")}
                alt=""
                width={photo.width}
                height={photo.height}
                decoding="async"
              />
            </picture>
            <span class="sr-only">{photo.alt}</span>
          </label>
        ))}
      </div>
    </div>
  ) : heroRow ? (
    /* The scrolling element is the region: focusable so a keyboard can scroll it,
       and named from the product so a screen reader says what it holds. It needs
       no script. Only the first image is eager and high priority; the rest are
       lazy, which on a phone is below the fold sideways. */
    <div
      class="gallery gallery--hero"
      role="region"
      aria-label={`Photographs of ${product.name}`}
      tabindex="0"
    >
      {shown.map((photo, i) => (
        <div class="gallery__hero-slide">
          <picture>
            <source type="image/avif" srcset={srcsetFor(photo.src, "avif")} sizes={SIZES} />
            <source type="image/webp" srcset={srcsetFor(photo.src, "webp")} sizes={SIZES} />
            <img
              class="gallery__img"
              src={photo.src}
              alt={photo.alt}
              width={photo.width}
              height={photo.height}
              loading={i === 0 ? "eager" : "lazy"}
              fetchpriority={i === 0 ? "high" : undefined}
              decoding="async"
            />
          </picture>
          {render && <p class="gallery__caption">{CAPTION}</p>}
        </div>
      ))}
    </div>
  ) : (
    <div class={last ? "gallery gallery--last" : "gallery"}>
      {shown.map((photo, i) => {
        /* Eager and high priority for the first image of a detail view only —
           it is above the fold and the largest thing on the page, so it is the
           LCP candidate. Everything else is below the fold, which is where
           CLAUDE.md's lazy rule applies, and that includes the first image of a
           card or a homepage reveal: both sit under the hero. The hero's own
           photograph is the exception, and it asks with `hero`. */
        const lead = (detail || hero) && !last && i === 0;

        return (
          <>
            <picture>
              <source type="image/avif" srcset={srcsetFor(photo.src, "avif")} sizes={SIZES} />
              <source type="image/webp" srcset={srcsetFor(photo.src, "webp")} sizes={SIZES} />
              <img
                class="gallery__img"
                src={photo.src}
                alt={photo.alt}
                width={photo.width}
                height={photo.height}
                loading={lead ? "eager" : "lazy"}
                fetchpriority={lead ? "high" : undefined}
                decoding="async"
              />
            </picture>
            {render && <p class="gallery__caption">{CAPTION}</p>}
          </>
        );
      })}
    </div>
  )
}

<style>
  .gallery {
    display: grid;
    gap: var(--s-12);
  }

  /* One 3:4 crop, everywhere. The ratio is stated in CSS as well as in the
     width and height attributes so the box is reserved even if a rendition
     fails to load — a 404 image with no ratio collapses the column and moves
     everything under it, which is the layout shift the attributes exist to
     prevent, arriving by the other door. */
  .gallery__img,
  .gallery__thumb-img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-surface);
    width: 100%;
    height: auto;
    display: block;
  }

  .gallery__caption {
    margin: 0;
    font-size: var(--t-caption);
    line-height: 1.4;
    color: var(--fg-muted);
    text-align: left;
  }

  /* ---------- the hero row ---------- */

  /* Under 900px: one horizontal row that snaps. Mandatory snapping with each slide
     aligned to the start puts one image square on the left edge and lets the next
     one's edge show on the right, which is the only cue. The page never scrolls
     sideways: the overflow is this element's own, and overscroll-behavior stops a
     swipe at the end of the row from turning into a browser back gesture. */
  .gallery--hero {
    display: flex;
    gap: var(--s-16);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  /* A slide is the hero box, never wider than its share of the row. The caption
     sits directly beneath its own image and travels with it. */
  .gallery__hero-slide {
    flex: 0 0 min(var(--hero-image-width), var(--hero-slide-share));
    display: grid;
    gap: var(--s-12);
    align-content: start;
    scroll-snap-align: start;
  }

  /* From 900px: one row, equal widths, left-aligned. Each track is at most the
     hero box and shrinks equally when the column is narrower than three of them,
     so the row never overflows and never scrolls. minmax(0, ...) is what lets a
     track go below its content's minimum. */
  @media (min-width: 900px) {
    .gallery--hero {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: minmax(0, var(--hero-image-width));
      justify-content: start;
      overflow: visible;
      scroll-snap-type: none;
    }
  }

  /* ---------- the switch ---------- */

  /* The hidden radios are positioned absolutely by .sr-only. Anchoring them
     here keeps a focused radio inside the gallery, so focusing one never
     scrolls the page somewhere else. */
  .gallery--switch {
    position: relative;
  }

  /* The frame is what the radios show and hide: the photograph and its own
     caption travel together, so each render is labelled when seen alone. */
  .gallery__frame {
    display: none;
    gap: var(--s-12);
  }

  /* The count under the caption: a fact about the page, so docket type, muted. */
  .gallery__count {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    line-height: var(--lh-docket);
    letter-spacing: var(--tr-docket);
    color: var(--fg-muted);
    text-align: left;
  }

  /* Below 900px the strip is equal-width tiles filling the row under the
     photograph and its caption: three across, wrapping to a second row after
     that, or two across for a two-photograph product so the pair fills the row
     rather than leaving half of it empty. A tile is a third of 350px less two
     gaps, about 110px wide and 147px tall at 390px, far over the 44px minimum
     on both axes. Every tile stays in view, so nothing has to be scrolled to be
     found and the row needs no focus stop of its own — the radios are the
     keyboard path. */
  .gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--s-8);
  }

  .gallery__thumbs--two {
    grid-template-columns: repeat(2, 1fr);
  }

  /* A border, never a shadow, and never the accent — the accent means "you can
     check this", and which photograph is on screen is not a fact about the
     product. The selected tile is the one whose frame is the text colour.
     Every tile carries a transparent 1px border so choosing one changes a
     colour, not a size, and nothing beside it moves. */
  .gallery__thumb {
    display: block;
    border: 1px solid transparent;
    border-radius: var(--radius-surface);
    cursor: pointer;
    transition: border-color var(--dur) var(--ease);
  }

  /* One row per position, to SWITCH_MAX. The radio's position among the
     radios picks the main image and the thumbnail at the same position. */
  .gallery__radio:nth-of-type(1):checked ~ .gallery__main > :nth-child(1),
  .gallery__radio:nth-of-type(2):checked ~ .gallery__main > :nth-child(2),
  .gallery__radio:nth-of-type(3):checked ~ .gallery__main > :nth-child(3),
  .gallery__radio:nth-of-type(4):checked ~ .gallery__main > :nth-child(4),
  .gallery__radio:nth-of-type(5):checked ~ .gallery__main > :nth-child(5),
  .gallery__radio:nth-of-type(6):checked ~ .gallery__main > :nth-child(6) {
    display: grid;
  }

  .gallery__radio:nth-of-type(1):checked ~ .gallery__thumbs > :nth-child(1),
  .gallery__radio:nth-of-type(2):checked ~ .gallery__thumbs > :nth-child(2),
  .gallery__radio:nth-of-type(3):checked ~ .gallery__thumbs > :nth-child(3),
  .gallery__radio:nth-of-type(4):checked ~ .gallery__thumbs > :nth-child(4),
  .gallery__radio:nth-of-type(5):checked ~ .gallery__thumbs > :nth-child(5),
  .gallery__radio:nth-of-type(6):checked ~ .gallery__thumbs > :nth-child(6) {
    border-color: var(--fg);
  }

  /* The radio has focus but cannot be seen, so its thumbnail wears the ring —
     the same ring global.css gives every other focusable element. */
  .gallery__radio:nth-of-type(1):focus-visible ~ .gallery__thumbs > :nth-child(1),
  .gallery__radio:nth-of-type(2):focus-visible ~ .gallery__thumbs > :nth-child(2),
  .gallery__radio:nth-of-type(3):focus-visible ~ .gallery__thumbs > :nth-child(3),
  .gallery__radio:nth-of-type(4):focus-visible ~ .gallery__thumbs > :nth-child(4),
  .gallery__radio:nth-of-type(5):focus-visible ~ .gallery__thumbs > :nth-child(5),
  .gallery__radio:nth-of-type(6):focus-visible ~ .gallery__thumbs > :nth-child(6) {
    outline: 2px solid var(--fg);
    outline-offset: 2px;
  }

  /* From 900px the page is two columns and the strip stands to the left of the
     photograph, top-aligned with it, one tile wide at --thumb-width (96px, 128px
     tall). Three thumbnails are 3 x 128 + 2 x 8 = 400px, inside the 628px
     photograph at the 471px cap. Six would be 808px and run on below the
     photograph; nothing overlaps, and no product has more than three. */
  @media (min-width: 900px) {
    .gallery--switch {
      grid-template-columns: var(--thumb-width) 1fr;
      align-items: start;
    }

