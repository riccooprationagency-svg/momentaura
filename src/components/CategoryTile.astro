---
// One category. Identical treatment across all of them — variation between
// tiles reads as instability, which is what a suspicious buyer is scanning for.
//
// A tile exists only for a category with a listed product, so it always has a
// photograph to show: that category's first listed product's lead image, through
// Gallery with its defaults (one image, lazy, the render caption beneath). There
// is no placeholder branch because there is no case that reaches one.
import Gallery from "./Gallery.astro";
import { systemFor, type Product } from "../lib/products";

interface Props {
  slug: string;
  name: string;
  /** What the category holds, from CATEGORY_COPY. Declared there, never
   *  invented at render time. */
  line: string;
  /** The category's first listed product. */
  product: Product;
}

const { slug, name, line, product } = Astro.props;
const system = systemFor(product);
---

<!-- /hoodies, not /shop/hoodies. The category pages sit at the root, and this
     href pointed at a path step 6 does not build. -->
<a class="tile" href={`/${slug}`} data-system={system}>
  <Gallery product={product} />
  <span class="tile__name">{name}</span>
  <span class="tile__line">{line}</span>
</a>

<style>
  .tile {
    display: grid;
    gap: var(--s-12);
    text-decoration: none;
    /* Both, always. An element that sets data-system remaps --fg for its whole
       subtree, so painting the text without painting the ground leaves light
       ink on the dark canvas. */
    background-color: var(--bg);
    color: var(--fg);
    border: 1px solid transparent;
    border-radius: var(--radius-surface);
    padding: var(--s-8);
    transition: border-color var(--dur) var(--ease);
  }

  .tile:hover {
    border-color: var(--border);
  }

  .tile__name {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    text-transform: uppercase;
  }

  /* Sentence case, Archivo, --fg-muted. Not the accent and not mono: these
     lines name a kind of thing rather than stating a figure a buyer can check,
     and CATEGORY_COPY says so in as many words. Setting them in the data
     register would claim otherwise. */
  .tile__line {
    font-size: var(--t-caption);
    color: var(--fg-muted);
  }
</style>
