---
// One category. Identical treatment across all of them — variation between
// tiles reads as instability, which is what a suspicious buyer is scanning for.
//
// No category has a photograph yet, so every tile carries the same honest
// placeholder and renders light.
interface Props {
  slug: string;
  name: string;
  photo?: string | null;
}

const { slug, name, photo = null } = Astro.props;
const system = typeof photo === "string" && photo.trim() !== "" ? "dark" : "light";
---

<!-- /apparel, not /shop/apparel. The category pages sit at the root, and this
     href pointed at a path step 6 does not build. -->
<a class="tile" href={`/${slug}`} data-system={system}>
  {
    system === "light" ? (
      <span class="photo-pending" aria-hidden="true">{name}</span>
    ) : (
      <img src={photo} alt={name} width="600" height="800" loading="lazy" decoding="async" />
    )
  }
  <span class="tile__name">{name}</span>
</a>

<style>
  .tile {
    display: grid;
    gap: var(--s-12);
    text-decoration: none;
    /* Both, always. An element that sets data-system remaps --fg for its whole
       subtree, so painting the text without painting the ground leaves light
       ink on the dark canvas. */
    background-color: var(--bg);
    color: var(--fg);
    border: 1px solid transparent;
    border-radius: var(--radius-surface);
    padding: var(--s-8);
    transition: border-color var(--dur) var(--ease);
  }

  .tile:hover {
    border-color: var(--border);
  }

  .tile img {
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: var(--radius-surface);
    width: 100%;
    height: auto;
  }

  .tile__name {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    text-transform: uppercase;
  }
</style>
