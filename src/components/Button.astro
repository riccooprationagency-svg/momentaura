---
// Filled pill or ghost pill. One filled button per section, maximum — its
// rarity is the signal.
//
// Both variants resolve through the scoped semantic tokens, so one component
// renders correctly in either system. Neither variant ever takes the accent:
// the accent means "you can check this" and a button is an instruction.
interface Props {
  variant?: "filled" | "ghost";
  href?: string;
  type?: "button" | "submit";
  disabled?: boolean;
  id?: string;
  /**
   * id of the element explaining why this control cannot be operated. A screen
   * reader announcing "Add to order, unavailable" tells the buyer the button is
   * dead and nothing about why, which is precisely the ambiguity the disabled
   * state exists to remove — the reason is already on the page in one line, and
   * this is what points at it.
   */
  describedby?: string;
}

const {
  variant = "filled",
  href,
  type = "button",
  disabled = false,
  id,
  describedby,
  ...rest
} = Astro.props;

// A disabled control is never an anchor. An <a href> with aria-disabled still
// navigates on click and on Enter, and the only thing that stopped it here was
// pointer-events: none, which also suppressed the not-allowed cursor and left
// the keyboard path open. Dropping the href is the fix that holds both ways.
//
// isAnchor is named rather than inlined because every tag-specific attribute
// below is derived from it. Keying them off `href` instead — which is what this
// component did — meant <Button href disabled> rendered <button href> with no
// type, and a button with no type defaults to submit. Nothing passes both today,
// so nothing was broken; the component's contract was. One condition picks the
// tag and guards the attributes that belong to it. verify.mjs V10 asserts that.
const isAnchor = Boolean(href) && !disabled;
const Tag = isAnchor ? "a" : "button";
---

<!--
  rest carries the data-* hooks the cart script binds to, and it is spread FIRST
  so that every attribute below overrides it. A caller cannot smuggle href or
  type past the isAnchor guard: whatever rest holds, the explicit attributes are
  written afterwards and win, and undefined removes the attribute outright. The
  V10 contract survives the spread rather than depending on callers behaving.
-->
<Tag
  {...rest}
  class:list={["btn", `btn--${variant}`]}
  id={id}
  aria-describedby={describedby}
  href={isAnchor ? href : undefined}
  type={isAnchor ? undefined : type}
  aria-disabled={disabled ? "true" : undefined}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-target);
    padding-inline: var(--s-28);
    border-radius: var(--radius-button);
    font-size: var(--t-label);
    font-weight: var(--w-medium);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    text-decoration: none;
    cursor: pointer;
    transition: opacity var(--dur) var(--ease);
  }

  .btn:hover {
    opacity: 0.8;
  }

  /* Sold out, run closed, cut-off passed. Muted text, border outline, no fill —
     it reads as a control that exists and cannot be operated, which is exactly
     what it is. Higher specificity than either variant, so it overrides both.
     Never the accent: the accent means "you can check this".

     Not opacity: 0.5. Fading the filled pill halved the contrast of its label
     against the ground, so the one state that most needs to be legible was the
     least legible on the page. --fg-muted is a token measured against every
     surface it sits on. aria-disabled rather than the disabled attribute, so it
     stays in the tab order and a screen reader can still find it and hear why. */
  /* The outline is --fg-muted, not --border. --border on paper is --rule at
     1.23:1, so the pill had no visible edge and the control stopped looking like
     a control — on the one page where the disabled state exists to say "this is
     a real thing you cannot have right now". A disabled control still has to
     read as a control.

     Same token as the label, so it is already measured against every ground it
     sits on: --fg-muted on --bg is muted on paper at 6.78:1 and sisal on
     packing-dark at 7.27:1, both asserted in contrast.mjs and both required by
     V9. Nothing added to the palette.

     The full border shorthand, not border-color. A future variant that sets no
     border would otherwise inherit none, and the disabled state would render
     with no outline again — this state must not depend on another rule having
     supplied a border first. */
  .btn[aria-disabled="true"] {
    background-color: transparent;
    color: var(--fg-muted);
    border: 1px solid var(--fg-muted);
    cursor: not-allowed;
  }

  .btn[aria-disabled="true"]:hover {
    opacity: 1;
  }

  /* Kraft Board fill, cream text in the dark system. In the light system the
     same two tokens resolve to kraft and ink. The one elevated solid. */
  .btn--filled {
    background-color: var(--surface);
    color: var(--fg);
    border: 1px solid var(--surface);
  }

  /* The border does the work. */
  .btn--ghost {
    background-color: transparent;
    color: var(--fg);
    border: 1px solid var(--fg);
  }
</style>
