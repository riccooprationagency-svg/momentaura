---
// The shell every page composes. Head, skip link, nav, footer, edge label.
//
// The nav is Packing Dark from the first pixel rather than transparent-then-dark
// on scroll. Knowing when to switch needs a scroll listener, and CLAUDE.md says
// the cart is the only client-side JS. This shell ships zero.
//
// It is sticky rather than fixed: sticky occupies flow space, so no page needs
// to know the nav's height or compensate for it, and there is no layout shift.

import "../styles/global.css";
import devGuards from "../styles/dev-guards.css?raw";
import {
  absolute,
  emailParts,
  mailtoHref,
  organizationLd,
  phoneDisplay,
  publicFile,
  site,
  socialLinks,
  telHref,
  whatsappHref,
} from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Page chrome. Individual sections override per product. */
  system?: "dark" | "light";
  /* Whether the page is worth indexing. TRUE BY DEFAULT, because most pages
   * here are things a buyer should be able to find, and a content page that
   * silently fell out of the index would be invisible in the one way nobody
   * checks. The four that pass false act on one buyer's order (/track joined at
   * phase-2-domain-crawl), and
   * /order-received is the one that matters: it is reached holding an order
   * reference, and the reference is what opens an order on /track. robots.txt
   * disallows the same four; this is the half that still holds for a crawler
   * that reached the URL without asking. */
  index?: boolean;
  /* Whether this page has an address of its own. False only for the 404 page,
   * which Cloudflare serves at every URL that does not exist: a canonical or an
   * og:url there would name /404, a path nobody asked for, as the "real"
   * address of whatever was mistyped. verify.mjs V13 asserts 404.html carries
   * neither. */
  addressable?: boolean;
}

const { title, description, system = "dark", index = true, addressable = true } = Astro.props;

const path = Astro.url.pathname;

/* One spelling of a page's own address, shared with sitemap.xml through the
   same origin helper, so the canonical a crawler reads and the URL the sitemap
   offers cannot disagree. Root stays "/", everything else loses its trailing
   slash. verify.mjs V13 asserts the two agree across every built page. */
const canonical = addressable ? absolute(path === "/" ? "/" : path.replace(/\/+$/, "")) : null;

/* Absent until site.json names a real photograph AND that file is in public/.
   See lib/site.ts — it is a declared gap, not an oversight. The existence check
   is what stops a typo in site.json shipping an og:image every link preview
   fetches and gets a 404 for. */
const ogImagePath = publicFile(site.ogImage);
const ogImage = ogImagePath ? absolute(ogImagePath) : null;

/* Icons, each linked only if the file is actually in public/. None exists yet:
   the wordmark is not redrawn or retyped to make one, so a browser asking for
   /favicon.ico gets an honest 404 until a real file is added. Adding the file
   is the whole change; the link appears on the next build. */
const ICONS = [
  { href: publicFile("/favicon.svg"), rel: "icon", type: "image/svg+xml" },
  { href: publicFile("/favicon.ico"), rel: "icon", type: "image/x-icon" },
  { href: publicFile("/apple-touch-icon.png"), rel: "apple-touch-icon", type: "image/png" },
].filter((icon) => icon.href !== null);
const isCurrent = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);

// Shop is gone. It was a placeholder for a listing page that no longer exists in
// the plan — every other dead link here is scheduled in BUILD-ORDER section 10,
// and /shop was scheduled nowhere. Categories are reached from the homepage
// tiles, which is what EXPERIENCE stage 3 specifies, and a nav link to a page
// nobody intends to build is worse than one fewer link.
//
// It also cost aria-current: with category pages at the root, isCurrent("/shop")
// could never match a category or product URL, so the nav marked nothing as the
// current section. Two links plus the order count is a defensible nav for a
// five-product store. Revisit past roughly twenty products, when a real /shop
// listing earns its place.
const NAV = [
  { href: "/delivery", label: "Delivery" },
  { href: "/contact", label: "Contact" },
];

const FOOTER = [
  { href: "/delivery", label: "Delivery" },
  { href: "/track", label: "Track an order" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/privacy", label: "Privacy" },
];

/* The shop's own Facebook and Instagram pages, from site.json through the
   validator in lib/site.ts. Text only: no logo, no icon, no brand mark, because
   CLAUDE.md bans third-party trademarks in imagery. Plain links, no
   target="_blank", and noreferrer so following one does not tell the other
   site which page it came from. verify.mjs V15 holds all of this on dist/. */
const SOCIAL = socialLinks();

const year = new Date().getFullYear();

/* Data, not code: a browser does not execute application/ld+json. "<" is
   escaped so no value can close the tag early. verify.mjs V4 allows exactly
   this one block per page and checks that it parses. */
const ld = JSON.stringify(organizationLd()).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}

    {canonical && <link rel="canonical" href={canonical} />}
    {!index && <meta name="robots" content="noindex, follow" />}

    {ICONS.map((icon) => <link rel={icon.rel} href={icon.href} type={icon.type} />)}

    {/* Open Graph, because most traffic arrives cold on one page from a
        WhatsApp link and the preview card is the first thing anyone sees of
        this shop. og:url is absolute by specification, so the whole block waits
        on a real domain rather than naming a host nobody has registered.

        NO og:image YET. Every product still renders light with no photograph,
        and CLAUDE.md permits no stock, no supplier photo and nothing generated.
        A card is worth having and a dishonest one is not, so until a real
        photograph exists the preview is title and description — which is thin,
        and true. summary rather than summary_large_image for the same reason:
        the large card reserves space for an image and renders the gap. */}
    {
      canonical && (
        <>
          <meta property="og:type" content="website" />
          <meta property="og:site_name" content="MomentAura" />
          <meta property="og:locale" content="en_KE" />
          <meta property="og:title" content={title} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={canonical} />
          {ogImage && <meta property="og:image" content={ogImage} />}
          {/* The large card reserves space for an image and renders the gap
              when there is none, so the card size follows the image. */}
          <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
        </>
      )
    }

    <!-- Archivo only. JetBrains Mono sits lower on the page; preloading both
         competes for bandwidth and delays first paint. -->
    <link
      rel="preload"
      href="/fonts/archivo.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script is:inline type="application/ld+json" set:html={ld} />

    {import.meta.env.DEV && <style is:global set:html={devGuards} />}
  </head>

  <body data-system={system}>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="nav">
      <div class="nav__inner wrap">
        <a class="nav__wordmark" href="/">MomentAura</a>

        <nav class="nav__links" aria-label="Primary">
          {
            NAV.map((item) => (
              <a
                href={item.href}
                class="nav__link"
                aria-current={isCurrent(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <!--
          Server-renders hidden, and stays hidden until the cart script has read
          storage and found something. Hidden entirely at zero: an empty
          indicator on a first visit is noise advertising a feature they have
          not used, and a hardcoded "(0)" on a page where the buyer has three
          items would be the nav lying.

          Hidden is also the honest state with JavaScript off — there is no
          order to count, because there is nothing that could have added to one.
        -->
        <a class="nav__order" href="/order" data-order-count hidden>
          <span class="sr-only">Items in order:</span>
          <span aria-hidden="true">(</span><span data-order-units>0</span><span
            aria-hidden="true">)</span>
        </a>
      </div>
    </header>

    <span class="edge" aria-hidden="true">MomentAura — Nairobi</span>

    <main id="main">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap foot__inner">
        <div class="foot__mark">
          <span class="foot__wordmark">MomentAura</span>
          <span class="foot__place">Nairobi, Kenya</span>
        </div>

        <nav class="foot__links" aria-label="Footer">
          {FOOTER.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>

        <div class="foot__links foot__reach">
          <a href={whatsappHref("WEB-FOOTER")}>Message MomentAura on WhatsApp</a>
          <a href={telHref()}>Call {phoneDisplay()}</a>
          <a class="foot__email" href={mailtoHref("general")}
            >{emailParts("general")[0]}<wbr />{emailParts("general")[1]}</a
          >
        </div>

        {
          SOCIAL.length > 0 && (
            <nav class="foot__links" aria-label="MomentAura on social media">
              {SOCIAL.map((link) => (
                <a href={link.href} rel="noopener noreferrer">
                  {link.label}
                </a>
              ))}
            </nav>
          )
        }

        <p class="foot__legal">&copy; {year} MomentAura</p>
      </div>
    </footer>

    <!--
      The one script on the site. Astro hoists and bundles it into a single
      named module in dist/, referenced by the identical URL from every page —
      type="module", so it is deferred and never render-blocking. Everything
      inside it is deferred again behind requestIdleCallback.

      It loads from the shell rather than per page because the order count is
      in the shell. Confining it to /order and the product pages would leave
      the count silent on the homepage and the category pages, which is where
      the buyer actually browses; a count that is only true on two page types
      out of five is worse than no count. verify.mjs V4 holds the containment
      line instead: exactly one script, named, under 5KB, the same URL
      everywhere, and no inline script body anywhere in the output.
    -->
    <script>
      import "../scripts/cart.ts";
    </script>
  </body>
</html>

<style>
  /* ---------- skip link ---------- */

  .skip-link {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 20;
    transform: translateY(-100%);
    background-color: var(--surface);
    color: var(--fg);
    padding: var(--s-12) var(--s-20);
    border-radius: var(--radius-surface);
    text-decoration: none;
    font-size: var(--t-label);
    font-weight: var(--w-medium);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    transition: transform var(--dur) var(--ease);
  }

  .skip-link:focus-visible {
    transform: translateY(0);
  }

  /* ---------- nav ---------- */

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: var(--s-40);
    min-height: var(--s-56);
  }

  .nav__wordmark {
    /* The one place weight 600 appears in the whole system. */
    font-size: var(--t-body-sm);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: var(--tr-docket);
    text-decoration: none;
    margin-inline-end: auto;
    /* The home link, and it was a 26px target in a 56px bar. Same treatment as
       the nav links beside it: full hit area, no change to the bar's height. */
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .nav__links {
    display: flex;
    gap: var(--s-28);
  }

  .nav__link {
    font-size: var(--t-label);
    font-weight: var(--w-medium);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    text-decoration: none;
    /* 44px touch target without changing the visual height of the bar. */
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .nav__link[aria-current="page"] {
    border-bottom: 1px dashed var(--border);
  }

  .nav__order {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
    min-width: var(--tap-target);
    justify-content: flex-end;
  }

  /* Categories live in the six tiles, so there is no hamburger and nothing to
     put behind one. The bar collapses to wordmark and order count. */
  @media (max-width: 640px) {
    .nav__links {
      display: none;
    }

    .nav__inner {
      gap: var(--s-16);
    }
  }

  /* ---------- vertical edge label ---------- */

  .edge {
    position: fixed;
    top: 50%;
    right: var(--s-12);
    translate: 0 -50%;
    z-index: 5;
    writing-mode: vertical-rl;
    font-family: var(--font-mono);
    font-size: var(--t-micro);
    text-transform: uppercase;
    letter-spacing: var(--tr-label);
    color: var(--fg-muted);
    pointer-events: none;
    display: none;
  }

  @media (min-width: 1100px) {
    .edge {
      display: block;
    }
  }

  /* ---------- footer ---------- */

  .foot {
    border-top: 1px solid var(--border);
    margin-block-start: var(--s-120);
    padding-block: var(--s-56);
  }

  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-40);
    justify-content: space-between;
    align-items: flex-start;
  }

  .foot__mark {
    display: grid;
    gap: var(--s-8);
  }

  .foot__wordmark {
    font-size: var(--t-body-sm);
    font-weight: var(--w-semi);
    text-transform: uppercase;
    letter-spacing: var(--tr-docket);
  }

  .foot__place,
  .foot__legal {
    font-family: var(--font-mono);
    font-size: var(--t-docket);
    letter-spacing: var(--tr-docket);
    color: var(--fg-muted);
  }

  .foot__links {
    display: grid;
    gap: var(--s-12);
  }

  .foot__links a {
    font-size: var(--t-caption);
    text-decoration: none;
    display: flex;
    align-items: center;
    min-height: var(--tap-target);
  }

  .foot__links a:hover {
    text-decoration: underline;
    text-underline-offset: var(--underline-offset);
  }

  /* The longest address is wider than a 390px column in one piece. */
  .foot__email {
    overflow-wrap: anywhere;
  }

  @media (max-width: 640px) {
    .foot__inner {
      gap: var(--s-28);
    }
  }
</style>
