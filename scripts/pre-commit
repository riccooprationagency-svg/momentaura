#!/bin/sh
#
# MomentAura pre-commit gate.
#
# Canonical copy. .git/hooks is not version controlled, so this lives in the
# repo and is installed by copying:
#
#   cp scripts/pre-commit .git/hooks/pre-commit
#
# A fresh clone has no hooks until someone runs that. See README.md.
#
# Runs the constraint gates, then the money-path test. V2 and V3 inside
# verify.mjs guard the accent rule — the constraint CLAUDE.md calls the single
# most important in the file, and the one that erodes without anything failing.
# It has to run without anyone remembering to run it.
#
#   SKIP_BUILD=1 git commit ...   commit without rebuilding (V4 uses stale dist/)
#   git commit --no-verify ...    skip this hook entirely
#
set -e

echo ""
echo "  pre-commit — MomentAura constraint gates"

if [ -z "$SKIP_BUILD" ]; then
  echo "  building so the output checks measure current code..."
  if ! npm run build >/dev/null 2>&1; then
    echo ""
    echo "  BUILD FAILED. Commit refused."
    echo "  Run npm run build to see why, or SKIP_BUILD=1 to commit anyway."
    echo ""
    exit 1
  fi
fi

node scripts/contrast.mjs
node scripts/verify.mjs

# The money endpoint. functions/ sits outside the Astro build, so nothing above
# ever loads it: contrast.mjs reads tokens.css, verify.mjs walks src/ and dist/,
# and a checkout.js broken in half would pass every gate in this hook. It is
# also the one file CLAUDE.md calls the highest-risk in the repo. A test that
# guards the money path and is never run is a comment, so it runs here too.
node scripts/checkout-test.mjs

echo "  gates passed."
echo ""
